<!-- PARTIALS: theme_manager.ejs -->
<style>
/* =========================================
   UNIVERSAL DARK MODE STYLE INJECTION 
   ========================================= */
body.dark-mode {
    --bg: #0f172a !important;            /* Slate 900 */
    --card-bg: #1e293b !important;       /* Slate 800 */
    --sidebar-bg: #1e293b !important;    /* For dashboard */
    --text-primary: #f8fafc !important;  /* Slate 50 */
    --text-secondary: #94a3b8 !important;/* Slate 400 */
    --text-muted: #64748b !important;    /* Slate 500 */
    --border: #334155 !important;        /* Slate 700 */
}

/* Transisi Halus Saat Pergantian Tema Aktif (Mencegah flash saat reload) */
body.theme-switching, body.theme-switching * {
    transition: background-color 0.5s ease-in-out, color 0.5s ease-in-out, border-color 0.5s ease-in-out, box-shadow 0.5s ease-in-out !important;
}

/* Perbaikan Kontras untuk Elemen Spesifik di Mode Gelap */
body.dark-mode .nav-link:hover { background-color: #334155 !important; color: #38bdf8 !important; }
body.dark-mode .nav-link.active { background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(56, 189, 248, 0.05)); color: #38bdf8 !important; }
body.dark-mode .nav-link.active i { color: #38bdf8 !important; }
body.dark-mode .form-input { background-color: #0f172a; color: #f8fafc; border-color: #334155; }
body.dark-mode .form-input:focus { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2); }
body.dark-mode select.form-input { background-color: #0f172a; }
body.dark-mode .users-table th, body.dark-mode .transactions-table th { background: #334155 !important; color: #e2e8f0; }
body.dark-mode .users-table tr:hover td, body.dark-mode .transactions-table tr:hover td { background: #0f172a !important; }
body.dark-mode .collapse-container { background: #1e293b !important; border-color: #334155 !important; }
body.dark-mode .collapse-header { background: #334155 !important; color: #f8fafc !important; }
body.dark-mode .collapse-header:hover { background: #475569 !important; }
body.dark-mode .collapse-content { background: #1e293b !important; color: #cbd5e1 !important; border-top-color: #334155 !important; }
body.dark-mode .btn-upload:hover { background-color:#334155 !important; }
body.dark-mode .user-card { background: #1e293b !important; border: 1px solid #334155; }
body.dark-mode .custom-footer { background: #1e293b !important; border-top-color: #334155 !important; }
body.dark-mode .settings-card { border: 1px solid #334155 !important; background: #1e293b !important; }

/* Menyesuaikan warna latar Smart Calculator di mode gelap */
body.dark-mode #calculator-panel { border-color: #334155 !important; background: #1e293b !important; }
body.dark-mode .calc-header { background: #334155 !important; border-bottom: 1px solid #0f172a !important; }
body.dark-mode .calc-display { background: #1e293b !important; }
body.dark-mode .calc-keys { background: #334155 !important; }
body.dark-mode .calc-btn { background: #1e293b !important; color: #f8fafc !important; }
body.dark-mode .calc-btn:hover { background: #334155 !important; }
body.dark-mode .calc-btn.operator { background: #0f172a !important; color: #38bdf8 !important; }
body.dark-mode .calc-btn.operator:hover { background: #1e293b !important; }
body.dark-mode .calc-smart-row { background: #0f172a !important; border-bottom: 1px solid #334155 !important; }
body.dark-mode .btn-smart { background: #1e293b !important; border: 1px solid #334155 !important; color: #38bdf8 !important; }
body.dark-mode .btn-smart:hover { background: #38bdf8 !important; color: #0f172a !important; }
body.dark-mode #calc-budget-menu { background: #1e293b !important; border-bottom: 1px solid #334155 !important; }
body.dark-mode .budget-item { border-bottom: 1px solid #334155 !important; }
body.dark-mode .budget-item:hover { background: #334155 !important; }
body.dark-mode .trans-item:hover, body.dark-mode .cat-item:hover { background: #334155 !important; border-color: #475569 !important; }

/* Tambahan agar ikon bisa berputar dan membesar karena di CSS default <i> itu inline */
#theme-icon {
    display: inline-block;
    transform-origin: center;
}
</style>

<script>
/* =========================================
   DARK MODE MEMORY & TOGGLE LOGIC
   ========================================= */
(function() {
    // Dipanggil langsung saat halaman mulai di-render (mencegah kedipan)
    if(localStorage.getItem('theme') === 'dark') {
        document.body.classList.add('dark-mode');
    }
})();

function toggleGlobalTheme() {
    // 1. Tambahkan kelas penanda mode transisi ke seluruh tubuh
    document.body.classList.add('theme-switching');

    const themeIcon = document.getElementById('theme-icon');
    const themeBtn = document.getElementById('theme-btn');
    const themeText = document.getElementById('theme-text');

    if (themeIcon) {
        themeIcon.style.transition = 'transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55)';
        themeIcon.style.transform = 'rotate(180deg) scale(0)';
    }
    
    if (themeBtn) {
        themeBtn.style.transform = 'scale(0.92)';
    }

    setTimeout(() => {
        document.body.classList.toggle('dark-mode');
        const isDark = document.body.classList.contains('dark-mode');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        
        if (themeIcon) {
            if (isDark) {
                themeIcon.className = 'fas fa-sun';
                themeIcon.style.color = '#f59e0b';
                if(themeText) themeText.innerText = 'Mode Terang';
            } else {
                themeIcon.className = 'fas fa-moon';
                themeIcon.style.color = 'inherit';
                if(themeText) themeText.innerText = 'Mode Gelap';
            }
            themeIcon.style.transform = 'rotate(360deg) scale(1)';
        }
        
        if (themeBtn) {
            themeBtn.style.transform = 'scale(1)';
        }
    }, 250);
    
    setTimeout(() => {
        document.body.classList.remove('theme-switching');
        if (themeIcon) {
            setTimeout(() => {
                themeIcon.style.transition = '';
                themeIcon.style.transform = '';
            }, 50);
        }
    }, 700);
}

window.addEventListener('DOMContentLoaded', () => {
    const isDark = document.body.classList.contains('dark-mode');
    const themeIcon = document.getElementById('theme-icon');
    const themeText = document.getElementById('theme-text');
    if (themeIcon && isDark) {
        themeIcon.className = 'fas fa-sun';
        themeIcon.style.color = '#f59e0b';
        if(themeText) themeText.innerText = 'Mode Terang';
    }
});
</script>
