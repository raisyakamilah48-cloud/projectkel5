<!-- views/dashboard.ejs -->
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - CekUangku</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        /* STYLE DASAR */
        body { display: flex; height: 100vh; overflow: hidden; background: #f3f4f6; }
        
        /* SIDEBAR */
        .sidebar {
            width: 250px; background: #fff; display: flex; flex-direction: column;
            border-right: 1px solid #e5e7eb; transition: all 0.3s;
        }
        .sidebar-header {
            padding: 20px; display: flex; align-items: center; gap: 10px;
            color: #4361ee; font-weight: 700; font-size: 1.2rem; border-bottom: 1px solid #f0f0f0;
        }
        .sidebar-menu { flex: 1; padding: 20px 0; overflow-y: auto; }
        .menu-item {
            display: flex; align-items: center; padding: 12px 25px;
            color: #6b7280; text-decoration: none; font-weight: 500; transition: 0.3s; cursor: pointer;
        }
        .menu-item:hover, .menu-item.active {
            background: #eff6ff; color: #4361ee; border-right: 3px solid #4361ee;
        }
        .menu-item i { width: 25px; }

        .user-profile {
            padding: 20px; border-top: 1px solid #f0f0f0; display: flex; align-items: center; gap: 10px;
        }
        .avatar {
            width: 40px; height: 40px; background: #4361ee; color: white;
            border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;
        }

        /* MAIN CONTENT */
        .main-content { flex: 1; overflow-y: auto; padding: 30px; }
        .dashboard-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .dashboard-header h2 { color: #1f2937; }

        /* CARDS */
        .grid-container {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px; margin-bottom: 30px;
        }
        .card {
            background: white; padding: 20px; border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }
        .card-header { font-size: 0.9rem; color: #6b7280; margin-bottom: 10px; }
        .card-value { font-size: 1.5rem; font-weight: 700; color: #1f2937; }
        .trend { font-size: 0.8rem; margin-top: 5px; }
        .trend.up { color: #10b981; }
        .trend.down { color: #ef4444; }

        /* DONUT CHART & TABLE LAYOUT */
        .content-row {
            display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;
        }
        
        .chart-box, .table-container {
            background: white; padding: 20px; border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }
        .chart-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 20px; }

        /* TABLE */
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th { text-align: left; padding: 12px; border-bottom: 2px solid #f3f4f6; color: #6b7280; font-size: 0.9rem; }
        td { padding: 12px; border-bottom: 1px solid #f3f4f6; color: #374151; font-size: 0.95rem; }
        .status { padding: 5px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 500; }
        .status.success { background: #d1fae5; color: #065f46; }
        .status.danger { background: #fee2e2; color: #991b1b; }

        @media (max-width: 768px) {
            body { flex-direction: column; overflow: auto; }
            .sidebar { width: 100%; border-right: none; border-bottom: 1px solid #e5e7eb; }
            .content-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <nav class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-wallet"></i> CekUangku
        </div>
        <div class="sidebar-menu">
            <!-- MENU INI AKTIF -->
            <a href="/dashboard" class="menu-item active"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/transactions" class="menu-item"><i class="fas fa-exchange-alt"></i> Transactions</a>
            <!-- LINK KE REPORTS BARU -->
            <a href="/reports" class="menu-item"><i class="fas fa-chart-pie"></i> Reports</a>
            <a href="#" class="menu-item"><i class="fas fa-bullseye"></i> Budget</a>
            <a href="#" class="menu-item"><i class="fas fa-cog"></i> Settings</a>
        </div>
        <div class="user-profile">
            <div class="avatar"><%= (typeof user !== 'undefined' && user.nama) ? user.nama.charAt(0).toUpperCase() : 'U' %></div>
            <div style="flex:1;">
                <div style="font-weight: 600; font-size: 0.9rem;"><%= (typeof user !== 'undefined' && user.nama) ? user.nama : 'User' %></div>
                <div style="font-size: 0.8rem; color: #6b7280;">Online</div>
            </div>
            <a href="/auth/logout" title="Logout" style="color: #ef4444; text-decoration: none;"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        <div class="dashboard-header">
            <h2>Dashboard Overview</h2>
            <button class="btn btn-primary" style="width: auto; padding: 10px 20px; font-size: 0.9rem; background: #4361ee; color: white; border: none; border-radius: 8px; cursor: pointer;">
                <i class="fas fa-download"></i> Download Report
            </button>
        </div>

        <!-- 1. STATS CARDS (BUTTON) -->
        <div class="grid-container">
            <div class="card">
                <div class="card-header">Total Balance</div>
                <div class="card-value">Rp 15.250.000</div>
                <div class="trend up"><i class="fas fa-arrow-up"></i> +2.5% dari bulan lalu</div>
            </div>
            <div class="card">
                <div class="card-header">Monthly Income</div>
                <div class="card-value">Rp 8.500.000</div>
                <div class="trend up"><i class="fas fa-arrow-up"></i> +10%</div>
            </div>
            <div class="card">
                <div class="card-header">Monthly Expenses</div>
                <div class="card-value">Rp 4.250.000</div>
                <div class="trend down"><i class="fas fa-arrow-down"></i> -5% (Lebih hemat)</div>
            </div>
            <div class="card">
                <div class="card-header">Savings Goal</div>
                <div class="card-value">75%</div>
                <div class="trend up">Target: Rp 20.000.000</div>
            </div>
        </div>

        <!-- 2. CONTENT ROW: DONUT CHART & TABLE -->
        <div class="content-row">
            
            <!-- KIRI: DIAGRAM LINGKARAN -->
            <div class="chart-box">
                <div class="chart-title">Expenses Category</div>
                <div style="height: 300px; position: relative;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>

            <!-- KANAN: RECENT TRANSACTIONS (3 ITEM) -->
            <div class="table-container">
                <div class="chart-title">Recent Transactions</div>
                <table>
                    <thead>
                        <tr>
                            <th>Transaction</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- ITEM 1 -->
                        <tr>
                            <td><i class="fas fa-shopping-bag" style="color:#4361ee; margin-right:10px;"></i> Belanja Bulanan</td>
                            <td>Oct 24, 2023</td>
                            <td style="color:#ef4444;">- Rp 450.000</td>
                            <td><span class="status success">Completed</span></td>
                        </tr>
                        <!-- ITEM 2 -->
                        <tr>
                            <td><i class="fas fa-briefcase" style="color:#10b981; margin-right:10px;"></i> Gaji Bulanan</td>
                            <td>Oct 01, 2023</td>
                            <td style="color:#10b981;">+ Rp 8.500.000</td>
                            <td><span class="status success">Completed</span></td>
                        </tr>
                        <!-- ITEM 3 -->
                        <tr>
                            <td><i class="fas fa-bolt" style="color:#f59e0b; margin-right:10px;"></i> Listrik PLN</td>
                            <td>Sep 28, 2023</td>
                            <td style="color:#ef4444;">- Rp 250.000</td>
                            <td><span class="status danger">Pending</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </main>

    <script>
        // HANYA DIAGRAM LINGKARAN (DONUT)
        const ctxCat = document.getElementById('categoryChart').getContext('2d');
        new Chart(ctxCat, {
            type: 'doughnut',
            data: {
                labels: ['Food', 'Transport', 'Bills', 'Entertainment'],
                datasets: [{
                    data: [300, 150, 100, 80],
                    backgroundColor: ['#4361ee', '#3f37c9', '#f72585', '#7209b7'],
                    borderWidth: 0
                }]
            },
            options: { 
                responsive: true, 
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>
</body>
</html>