<!-- views/dashboard.ejs -->
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Dashboard - CekUangku</title>
    <link rel="icon" type="image/png" href="/images/asset-avatar/Main.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        /* =============================================
           DASHBOARD — PREMIUM MODERN DESIGN
           ============================================= */
        :root {
            --primary: #4361ee;
            --primary-dark: #3730a3;
            --primary-light: #818cf8;
            --accent: #06b6d4;
            --success: #10b981;
            --success-light: #d1fae5;
            --danger: #ef4444;
            --danger-light: #fee2e2;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --info: #6366f1;
            --info-light: #e0e7ff;
            --bg: #f0f2f5;
            --sidebar-bg: #ffffff;
            --card-bg: #ffffff;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --border: #e2e8f0;
            --sidebar-w: 260px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text-primary); display: flex; height: 100vh; overflow: hidden; }

        /* ---- SIDEBAR ---- */
        .sidebar {
            width: var(--sidebar-w);
            background: var(--sidebar-bg);
            height: 100vh;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--border);
            position: fixed;
            left: 0;
            top: 0;
            z-index: 100;
            transition: transform .3s ease;
        }

        .sidebar-brand {
            padding: 24px 24px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--border);
        }

        .sidebar-brand .brand-icon {
            width: 52px; height: 52px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1.1rem;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .sidebar-brand .brand-name {
            font-size: 1.25rem; font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .sidebar-nav {
            flex: 1;
            padding: 16px 12px;
            overflow-y: auto;
        }

        .nav-label {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--text-muted);
            padding: 12px 16px 8px;
        }

        .nav-link {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 16px;
            border-radius: 10px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all .2s ease;
            margin-bottom: 2px;
        }

        .nav-link:hover { background: #f1f5f9; color: var(--primary); }
        .nav-link.active {
            background: linear-gradient(135deg, rgba(67, 97, 238, 0.1), rgba(6, 182, 212, 0.05));
            color: var(--primary);
            font-weight: 600;
        }
        .nav-link.active i { color: var(--primary); }
        .nav-link i { width: 20px; text-align: center; font-size: 1rem; }

        .sidebar-footer {
            padding: 16px 16px 20px;
            border-top: 1px solid var(--border);
        }

        .user-card {
            display: flex; align-items: center; gap: 12px;
            padding: 12px;
            background: #f8fafc;
            border-radius: 12px;
        }

        .user-avatar {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: white; font-weight: 700; font-size: 1rem;
        }

        .user-info { flex: 1; }
        .user-info .name { font-weight: 600; font-size: 0.85rem; color: var(--text-primary); }
        .user-info .status { font-size: 0.75rem; color: var(--success); display: flex; align-items: center; gap: 4px; }
        .user-info .status::before { content: ''; width: 6px; height: 6px; background: var(--success); border-radius: 50%; }

        .btn-logout {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 1rem;
            transition: color .2s;
        }
        .btn-logout:hover { color: var(--danger); }

        /* ---- MAIN ---- */
        .main-area {
            margin-left: var(--sidebar-w);
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
        }

        /* Top Header */
        .top-header {
            background: var(--card-bg);
            padding: 20px 32px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .greeting h2 { font-size: 1.35rem; font-weight: 700; color: var(--text-primary); }
        .greeting p { font-size: 0.85rem; color: var(--text-secondary); margin-top: 2px; }

        .header-actions { display: flex; align-items: center; gap: 12px; }
        .header-actions .date-badge {
            background: var(--info-light);
            color: var(--info);
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        /* Content */
        .content-area { padding: 28px 32px; }

        /* ---- STAT CARDS ---- */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid var(--border);
            transition: all .3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 3px;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px -8px rgba(0,0,0,0.1);
        }

        .stat-card.balance::before { background: linear-gradient(90deg, var(--primary), var(--accent)); }
        .stat-card.income::before { background: linear-gradient(90deg, var(--success), #34d399); }
        .stat-card.expense::before { background: linear-gradient(90deg, var(--danger), #fb923c); }
        .stat-card.count::before { background: linear-gradient(90deg, var(--warning), #fbbf24); }

        .stat-top {
            display: flex; justify-content: space-between; align-items: flex-start;
            margin-bottom: 16px;
        }

        .stat-label {
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
        }

        .stat-icon {
            width: 44px; height: 44px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
        }

        .stat-icon.blue { background: var(--info-light); color: var(--primary); }
        .stat-icon.green { background: var(--success-light); color: var(--success); }
        .stat-icon.red { background: var(--danger-light); color: var(--danger); }
        .stat-icon.yellow { background: var(--warning-light); color: var(--warning); }

        .stat-value {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .stat-value.small { font-size: 1.4rem; }

        /* ---- CHARTS ROW ---- */
        .charts-row {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 20px;
            margin-bottom: 28px;
        }

        .card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid var(--border);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .card-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .card-subtitle {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .chart-wrap {
            position: relative;
            height: 280px;
        }

        .donut-center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
        }

        .donut-center-text .amount {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .donut-center-text .label {
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        /* ---- RECENT TRANSACTIONS ---- */
        .transactions-card { }

        .trans-list { list-style: none; }

        .trans-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 0;
            border-bottom: 1px solid #f1f5f9;
            transition: background .2s;
        }

        .trans-item:last-child { border-bottom: none; }
        .trans-item:hover { background: #fafbfc; margin: 0 -24px; padding: 14px 24px; border-radius: 8px; }

        .trans-left {
            display: flex; align-items: center; gap: 14px;
        }

        .trans-icon {
            width: 42px; height: 42px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem;
        }

        .trans-icon.income-icon { background: var(--success-light); color: var(--success); }
        .trans-icon.expense-icon { background: var(--danger-light); color: var(--danger); }

        .trans-desc .desc-text { font-weight: 600; font-size: 0.9rem; color: var(--text-primary); }
        .trans-desc .desc-meta { font-size: 0.78rem; color: var(--text-muted); margin-top: 2px; }

        .trans-amount { font-weight: 700; font-size: 0.95rem; }
        .trans-amount.positive { color: var(--success); }
        .trans-amount.negative { color: var(--danger); }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-state i {
            font-size: 3rem;
            color: var(--text-muted);
            opacity: 0.4;
            margin-bottom: 16px;
        }

        .empty-state h3 {
            font-size: 1.1rem;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .empty-state p {
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .empty-state .btn-cta {
            display: inline-block;
            margin-top: 16px;
            padding: 10px 24px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: white;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.85rem;
            transition: transform .2s, box-shadow .2s;
        }

        .empty-state .btn-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.3);
        }

        /* ---- ANIMATIONS ---- */
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .stat-card { animation: slideUp .5s ease forwards; }
        .stat-card:nth-child(1) { animation-delay: .05s; }
        .stat-card:nth-child(2) { animation-delay: .1s; }
        .stat-card:nth-child(3) { animation-delay: .15s; }
        .stat-card:nth-child(4) { animation-delay: .2s; }
        .charts-row { animation: slideUp .5s ease .25s forwards; opacity: 0; }
        .transactions-card { animation: slideUp .5s ease .3s forwards; opacity: 0; }

        /* ---- RESPONSIVE ---- */
        @media (max-width: 1200px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); box-shadow: 4px 0 20px rgba(0,0,0,0.1); }
            .main-area { margin-left: 0; }
            .charts-row { grid-template-columns: 1fr; }
            .menu-toggle { display: block !important; }
        }

        @media (max-width: 600px) {
            .stats-grid { grid-template-columns: 1fr; }
            .content-area { padding: 20px 16px; }
            .top-header { padding: 16px; }
        }

        .menu-toggle { display: none; background: none; border: none; cursor: pointer; padding: 8px; border-radius: 8px; color: var(--text-secondary); }
        .menu-toggle:hover { background: #f1f5f9; }
    </style>
</head>
<body>

    <!-- ===== SIDEBAR ===== -->
    <!-- ===== SIDEBAR ===== -->
    <%- include('partials/sidebar', { activeMenu: 'dashboard' }) %>

    <!-- ===== MAIN AREA ===== -->
    <main class="main-area">
        <!-- Top Header -->
        <header class="top-header">
            <div style="display:flex;align-items:center;gap:12px;">
                <button class="menu-toggle" onclick="document.getElementById('sidebar').classList.toggle('open')">
                    <i class="fas fa-bars" style="font-size:1.2rem;"></i>
                </button>
                <div class="greeting">
                    <h2 id="greetingText">Halo, <%= (user && user.nama) ? user.nama : 'User' %> 👋</h2>
                    <p>Berikut ringkasan keuangan kamu hari ini</p>
                </div>
            </div>
            <div class="header-actions">
                <div class="date-badge" id="currentDate"></div>
            </div>
        </header>

        <!-- Content -->
        <div class="content-area">

            <!-- STAT CARDS -->
            <div class="stats-grid">
                <div class="stat-card balance">
                    <div class="stat-top">
                        <span class="stat-label">Total Saldo</span>
                        <div class="stat-icon blue"><i class="fas fa-wallet"></i></div>
                    </div>
                    <div class="stat-value small"><%= totalBalance >= 0 ? '' : '-' %>Rp <%= Math.abs(totalBalance).toLocaleString('id-ID') %></div>
                </div>

                <div class="stat-card income">
                    <div class="stat-top">
                        <span class="stat-label">Total Pemasukan</span>
                        <div class="stat-icon green"><i class="fas fa-arrow-down"></i></div>
                    </div>
                    <div class="stat-value small">Rp <%= totalIncome.toLocaleString('id-ID') %></div>
                </div>

                <div class="stat-card expense">
                    <div class="stat-top">
                        <span class="stat-label">Total Pengeluaran</span>
                        <div class="stat-icon red"><i class="fas fa-arrow-up"></i></div>
                    </div>
                    <div class="stat-value small">Rp <%= totalExpense.toLocaleString('id-ID') %></div>
                </div>

                <div class="stat-card count">
                    <div class="stat-top">
                        <span class="stat-label">Total Transaksi</span>
                        <div class="stat-icon yellow"><i class="fas fa-receipt"></i></div>
                    </div>
                    <div class="stat-value"><%= transactionCount %></div>
                </div>
            </div>

            <!-- CHARTS -->
            <div class="charts-row">
                <!-- Line Chart: Monthly Trend -->
                <div class="card">
                    <div class="card-header" style="justify-content: space-between;">
                        <div>
                            <div class="card-title">Tren Keuangan Bulanan</div>
                            <div class="card-subtitle">Pemasukan vs Pengeluaran</div>
                        </div>
                        <button id="btnToggleChart" onclick="toggleChartType()" style="background: var(--bg); border: 1px solid var(--border); color: var(--text-primary); padding: 8px 14px; border-radius: 8px; font-size: 0.8rem; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: background 0.2s; font-weight: 600;">
                            <i class="fas fa-chart-bar"></i> Bar Chart
                        </button>
                    </div>
                    <div class="chart-wrap">
                        <% if (monthlyData.length > 0) { %>
                            <canvas id="trendChart"></canvas>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="fas fa-chart-line"></i>
                                <h3>Belum ada data</h3>
                                <p>Tambahkan transaksi untuk melihat grafik tren</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Doughnut Chart: Category -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">Kategori Pengeluaran</div>
                            <div class="card-subtitle">Distribusi per kategori</div>
                        </div>
                    </div>
                    <div class="chart-wrap">
                        <% if (categoryData.length > 0) { %>
                            <canvas id="categoryChart"></canvas>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="fas fa-chart-pie"></i>
                                <h3>Belum ada data</h3>
                                <p>Tambahkan pengeluaran untuk melihat chart</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- RECENT TRANSACTIONS -->
            <div class="card transactions-card">
                <div class="card-header">
                    <div>
                        <div class="card-title">Transaksi Terbaru</div>
                        <div class="card-subtitle">5 transaksi terakhir kamu</div>
                    </div>
                    <a href="/transactions" style="color:var(--primary);font-size:0.85rem;font-weight:600;text-decoration:none;">
                        Lihat Semua <i class="fas fa-arrow-right" style="font-size:0.7rem;"></i>
                    </a>
                </div>

                <% if (recentTransactions.length > 0) { %>
                    <ul class="trans-list">
                        <% recentTransactions.forEach(function(t) { %>
                            <li class="trans-item">
                                <div class="trans-left">
                                    <div class="trans-icon <%= t.type === 'income' ? 'income-icon' : 'expense-icon' %>">
                                        <i class="fas fa-<%= t.type === 'income' ? 'arrow-down' : 'arrow-up' %>"></i>
                                    </div>
                                    <div class="trans-desc">
                                        <div class="desc-text"><%= t.description %></div>
                                        <div class="desc-meta"><%= t.category || 'Lainnya' %> • <%= new Date(t.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                                    </div>
                                </div>
                                <div class="trans-amount <%= t.type === 'income' ? 'positive' : 'negative' %>">
                                    <%= t.type === 'income' ? '+' : '-' %> Rp <%= parseInt(t.amount).toLocaleString('id-ID') %>
                                </div>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <h3>Belum ada transaksi</h3>
                        <p>Mulai catat pemasukan dan pengeluaranmu</p>
                        <a href="/transactions" class="btn-cta">
                            <i class="fas fa-plus"></i> Tambah Transaksi
                        </a>
                    </div>
                <% } %>
            </div>

        </div>
    </main>

    <script>
        // === Date Display ===
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('currentDate').textContent = now.toLocaleDateString('id-ID', options);

        // === Greeting based on time ===
        const hour = now.getHours();
        let greet = 'Halo';
        if (hour >= 5 && hour < 12) greet = 'Selamat Pagi';
        else if (hour >= 12 && hour < 15) greet = 'Selamat Siang';
        else if (hour >= 15 && hour < 18) greet = 'Selamat Sore';
        else greet = 'Selamat Malam';
        document.getElementById('greetingText').textContent = greet + ', <%= (user && user.nama) ? user.nama : "User" %> 👋';

        // === Chart Colors ===
        const chartColors = ['#4361ee', '#06b6d4', '#8b5cf6', '#f59e0b', '#10b981', '#ef4444', '#ec4899', '#14b8a6'];

        <% if (monthlyData.length > 0) { %>
        // === TREND CHART (LINE) ===
        (function() {
            const rawData = <%- JSON.stringify(monthlyData) %>;
            const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
            
            // Build unique month labels
            const monthMap = {};
            rawData.forEach(function(r) {
                const key = r.year + '-' + String(r.month).padStart(2, '0');
                if (!monthMap[key]) {
                    monthMap[key] = { label: monthNames[r.month] + ' ' + r.year, income: 0, expense: 0 };
                }
                if (r.type === 'income') monthMap[key].income = parseFloat(r.total);
                if (r.type === 'expense') monthMap[key].expense = parseFloat(r.total);
            });

            const sorted = Object.keys(monthMap).sort();
            const labels = sorted.map(function(k) { return monthMap[k].label; });
            const incomeData = sorted.map(function(k) { return monthMap[k].income; });
            const expenseData = sorted.map(function(k) { return monthMap[k].expense; });

            window.currentChartType = 'bar'; // Default to bar if 1 month
            if (labels.length > 1) {
                window.currentChartType = 'line'; // Auto switch to line if multiple months
            }

            // Function to render chart cleanly
            window.renderTrendChart = function(type) {
                if (window.trendChartInstance) {
                    window.trendChartInstance.destroy();
                }

                const ctx = document.getElementById('trendChart').getContext('2d');
                
                // Colors logic based on type
                let bgIncome, bgExpense, borderW;
                if (type === 'line') {
                    bgIncome = ctx.createLinearGradient(0, 0, 0, 300);
                    bgIncome.addColorStop(0, 'rgba(16, 185, 129, 0.5)');
                    bgIncome.addColorStop(1, 'rgba(16, 185, 129, 0.0)');
                    
                    bgExpense = ctx.createLinearGradient(0, 0, 0, 300);
                    bgExpense.addColorStop(0, 'rgba(239, 68, 68, 0.5)');
                    bgExpense.addColorStop(1, 'rgba(239, 68, 68, 0.0)');
                    
                    borderW = 3;
                } else {
                    bgIncome = 'rgba(16, 185, 129, 0.9)';
                    bgExpense = 'rgba(239, 68, 68, 0.9)';
                    borderW = 0; // Solid modern bars without thick borders
                }

                // Calculate max to give breathing room on top
                const maxVal = Math.max(...incomeData, ...expenseData);

                window.trendChartInstance = new Chart(ctx, {
                    type: type,
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Pemasukan',
                                data: incomeData,
                                backgroundColor: bgIncome,
                                borderColor: '#10b981',
                                borderWidth: borderW,
                                borderRadius: type === 'bar' ? 6 : 0,
                                barPercentage: 0.6,
                                categoryPercentage: 0.8,
                                pointBackgroundColor: '#fff',
                                pointBorderColor: '#10b981',
                                pointBorderWidth: 2,
                                pointRadius: type === 'line' ? 5 : 0,
                                pointHoverRadius: 7,
                                fill: true,
                                tension: 0.4
                            },
                            {
                                label: 'Pengeluaran',
                                data: expenseData,
                                backgroundColor: bgExpense,
                                borderColor: '#ef4444',
                                borderWidth: borderW,
                                borderRadius: type === 'bar' ? 6 : 0,
                                barPercentage: 0.6,
                                categoryPercentage: 0.8,
                                pointBackgroundColor: '#fff',
                                pointBorderColor: '#ef4444',
                                pointBorderWidth: 2,
                                pointRadius: type === 'line' ? 5 : 0,
                                pointHoverRadius: 7,
                                fill: true,
                                tension: 0.4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { intersect: false, mode: 'index' },
                        plugins: {
                            legend: { position: 'top', labels: { usePointStyle: true, pointStyle: 'rectRounded', padding: 20, font: { size: 12, family: 'Inter' } } },
                            tooltip: {
                                backgroundColor: '#1e293b',
                                titleFont: { family: 'Inter', size: 13 },
                                bodyFont: { family: 'Inter', size: 12 },
                                padding: 12,
                                cornerRadius: 8,
                                callbacks: {
                                    label: function(ctx) { return ctx.dataset.label + ': Rp ' + ctx.parsed.y.toLocaleString('id-ID'); }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                suggestedMax: maxVal > 0 ? maxVal * 1.15 : undefined,
                                grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false },
                                ticks: {
                                    font: { family: 'Inter', size: 11 },
                                    color: '#94a3b8',
                                    callback: function(v) { return 'Rp ' + (v/1000000).toFixed(1) + 'jt'; }
                                }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: 'Inter', size: 11 }, color: '#94a3b8' }
                            }
                        }
                    }
                });
            };

            // First render
            renderTrendChart(window.currentChartType);
            
            // Set initial button HTML
            const btn = document.getElementById('btnToggleChart');
            if (window.currentChartType === 'bar') {
                btn.innerHTML = '<i class="fas fa-chart-line"></i> Line Chart';
            } else {
                btn.innerHTML = '<i class="fas fa-chart-bar"></i> Bar Chart';
            }

            // Toggle function hook attached to window
            window.toggleChartType = function() {
                window.currentChartType = window.currentChartType === 'line' ? 'bar' : 'line';
                
                if (window.currentChartType === 'bar') {
                    btn.innerHTML = '<i class="fas fa-chart-line"></i> Line Chart';
                } else {
                    btn.innerHTML = '<i class="fas fa-chart-bar"></i> Bar Chart';
                }
                
                renderTrendChart(window.currentChartType);
            };
        })();
        <% } %>

        <% if (categoryData.length > 0) { %>
        // === CATEGORY CHART (DOUGHNUT) ===
        (function() {
            const rawCat = <%- JSON.stringify(categoryData) %>;
            const labels = rawCat.map(function(c) { return c.category || 'Lainnya'; });
            const data = rawCat.map(function(c) { return parseFloat(c.total); });
            const colors = chartColors.slice(0, labels.length);

            const ctx2 = document.getElementById('categoryChart').getContext('2d');
            new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: colors,
                        borderWidth: 0,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { usePointStyle: true, pointStyle: 'circle', padding: 16, font: { family: 'Inter', size: 11 } }
                        },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: function(ctx) {
                                    const total = ctx.dataset.data.reduce(function(a, b) { return a + b; }, 0);
                                    const pct = Math.round((ctx.parsed / total) * 100);
                                    return ctx.label + ': Rp ' + ctx.parsed.toLocaleString('id-ID') + ' (' + pct + '%)';
                                }
                            }
                        }
                    }
                }
            });
        })();
        <% } %>
    </script>

    <% if (typeof showOnboarding !== 'undefined' && showOnboarding) { %>
    <!-- Tailwind CSS (Scoped) for Onboarding Modal -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: { preflight: false }
        }
    </script>
    <!-- ONBOARDING MODAL -->
    <div id="onboardingModal" class="fixed inset-0 z-[9999] flex items-center justify-center bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300" style="font-family: 'Inter', sans-serif;">
        <div class="relative w-full max-w-lg bg-white rounded-3xl shadow-2xl overflow-hidden flex flex-col transform transition-all scale-100 opacity-100 mx-4">
            
            <button id="ob-btn-close" class="absolute top-4 right-4 z-10 w-8 h-8 flex items-center justify-center text-slate-400 hover:text-slate-600 bg-white/80 hover:bg-slate-100 rounded-full transition-colors cursor-pointer" style="border: none;" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>

            <div id="ob-content" class="p-8">
                <h3 id="ob-title" class="text-2xl font-bold text-slate-800 mb-2"></h3>
                <p id="ob-desc" class="text-slate-600 text-[14px] leading-relaxed mb-6"></p>
                
                <div class="relative rounded-2xl overflow-hidden bg-slate-100 shadow-inner border border-slate-200" style="aspect-ratio: 16/9;">
                    <video id="ob-video" class="w-full h-full object-cover transition-opacity duration-300" autoplay loop muted playsinline>
                        <source id="ob-video-src" src="" type="video/mp4">
                    </video>
                    <img id="ob-image" src="" alt="Onboarding Image" class="absolute inset-0 w-full h-full object-cover hidden transition-opacity duration-300">
                </div>
            </div>
            
            <div class="px-8 py-5 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
                <div class="flex items-center space-x-2" id="ob-dots"></div>
                
                <div class="flex items-center space-x-3">
                    <button id="ob-btn-prev" class="px-4 py-2 text-sm font-semibold text-slate-500 hover:text-slate-800 transition-colors hidden cursor-pointer" style="background: none; border: none;">
                        Sebelumnya
                    </button>
                    <button id="ob-btn-next" class="px-5 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 cursor-pointer" style="border: none;">
                        Selanjutnya
                    </button>
                    <button id="ob-btn-finish" class="px-5 py-2 text-sm font-semibold text-white bg-emerald-500 hover:bg-emerald-600 rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 hidden cursor-pointer" style="border: none;">
                        Selesai
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const obSteps = [
            {
                title: "Langkah 1: Buat Dompet",
                desc: "Langkah pertama untuk menggunakan CekUangku adalah membuat dompet. Silakan buat dompet terlebih dahulu pada halaman Dompet.",
                video: "/Asset-Vidio/Pembuatan Dompet (Setp 1).mp4"
            },
            {
                title: "Langkah 2: Buat Kategori",
                desc: "Setelah memiliki dompet, buat kategori pengeluaran dan pemasukan pada halaman Kategori agar catatan lebih rapi.",
                video: "/Asset-Vidio/Pembuatan Kategoi (step 2).mp4"
            },
            {
                title: "Langkah 3: Catat Transaksi",
                desc: "Kini Anda siap! Catat setiap pemasukan dan pengeluaran Anda pada halaman Transaksi dengan memilih dompet dan kategori yang telah dibuat.",
                video: "/Asset-Vidio/Transaksi (Step 3).mp4"
            },
            {
                title: "Langkah 4: Pantau Keuangan",
                desc: "Lihat rekap dan ringkasan kesehatan finansial Anda pada halaman Dashboard atau Laporan.",
                video: "/Asset-Vidio/Penutup.mp4"
            },
            {
                title: "Selamat Menikmati",
                desc: "Silakan eksplorasi semua fitur yang ada untuk mengatur keuangan Anda menjadi lebih baik! Selamat mengelola keuangan!",
                image: "/images/asset-avatar/Happy.png"
            }
        ];

        let currentObStep = 0;

        const obTitle = document.getElementById('ob-title');
        const obDesc = document.getElementById('ob-desc');
        const obVideo = document.getElementById('ob-video');
        const obVideoSrc = document.getElementById('ob-video-src');
        const obImage = document.getElementById('ob-image');
        const obDots = document.getElementById('ob-dots');
        const obBtnPrev = document.getElementById('ob-btn-prev');
        const obBtnNext = document.getElementById('ob-btn-next');
        const obBtnFinish = document.getElementById('ob-btn-finish');
        const obBtnClose = document.getElementById('ob-btn-close');
        const obModal = document.getElementById('onboardingModal');

        function renderObStep(stepIndex) {
            const step = obSteps[stepIndex];
            
            obTitle.style.opacity = 0;
            obDesc.style.opacity = 0;
            
            setTimeout(() => {
                obTitle.textContent = step.title;
                obDesc.textContent = step.desc;
                obTitle.style.opacity = 1;
                obDesc.style.opacity = 1;
            }, 150);

            if (step.image) {
                obVideo.classList.add('hidden');
                obVideo.pause();
                obImage.src = step.image;
                obImage.classList.remove('hidden');
            } else {
                obImage.classList.add('hidden');
                obVideo.classList.remove('hidden');
                obVideo.pause();
                obVideoSrc.src = step.video;
                obVideo.load();
                const playPromise = obVideo.play();
                if (playPromise !== undefined) {
                    playPromise.catch(error => { console.log("Video auto-play prevented"); });
                }
            }

            // Update existing dots to animate smoothly
            Array.from(obDots.children).forEach((dot, idx) => {
                if (idx === stepIndex) {
                    dot.className = 'h-2 rounded-full transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] bg-blue-600 w-6';
                } else {
                    dot.className = 'h-2 rounded-full transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] bg-slate-300 w-2';
                }
            });

            if (stepIndex === 0) {
                obBtnPrev.classList.add('hidden');
            } else {
                obBtnPrev.classList.remove('hidden');
            }

            if (stepIndex === obSteps.length - 1) {
                obBtnNext.classList.add('hidden');
                obBtnFinish.classList.remove('hidden');
            } else {
                obBtnNext.classList.remove('hidden');
                obBtnFinish.classList.add('hidden');
            }
        }

        obBtnNext.addEventListener('click', () => {
            if (currentObStep < obSteps.length - 1) {
                currentObStep++;
                renderObStep(currentObStep);
            }
        });

        obBtnPrev.addEventListener('click', () => {
            if (currentObStep > 0) {
                currentObStep--;
                renderObStep(currentObStep);
            }
        });

        obBtnFinish.addEventListener('click', () => {
            obModal.style.opacity = '0';
            setTimeout(() => {
                obModal.remove();
            }, 300);
        });

        if (obBtnClose) {
            obBtnClose.addEventListener('click', () => {
                obModal.style.opacity = '0';
                setTimeout(() => {
                    obModal.remove();
                }, 300);
            });
        }

        // Initialize Dots
        obSteps.forEach((_, idx) => {
            const dot = document.createElement('div');
            dot.className = `h-2 rounded-full transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] ${idx === currentObStep ? 'bg-blue-600 w-6' : 'bg-slate-300 w-2'}`;
            obDots.appendChild(dot);
        });

        obTitle.style.transition = 'opacity 0.3s ease';
        obDesc.style.transition = 'opacity 0.3s ease';
        renderObStep(currentObStep);
    </script>
    <% } %>
</body>
</html>