<!-- views/admin.ejs -->
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - CekUangku</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { display: flex; height: 100vh; overflow: hidden; background: #1f2937; color: white; font-family: sans-serif; }
        .sidebar {
            width: 250px; background: #111827; border-right: 1px solid #374151; display: flex; flex-direction: column;
        }
        .sidebar-header { padding: 20px; font-size: 1.5rem; font-weight: bold; color: #ef4444; border-bottom: 1px solid #374151; }
        .menu-item { padding: 15px 20px; color: #9ca3af; text-decoration: none; display: block; border-left: 3px solid transparent; }
        .menu-item:hover, .menu-item.active { background: #374151; color: white; border-left-color: #ef4444; }
        .main-content { flex: 1; padding: 30px; overflow-y: auto; }
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: #374151; padding: 20px; border-radius: 8px; }
        .stat-value { font-size: 2rem; font-weight: bold; margin-top: 10px; }
        .server-status { background: #064e3b; padding: 20px; border-radius: 8px; border: 1px solid #10b981; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header"><i class="fas fa-shield-alt"></i> ADMIN PANEL</div>
        <a href="/admin" class="menu-item active"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="#" class="menu-item"><i class="fas fa-users"></i> Manage Users</a>
        <a href="#" class="menu-item"><i class="fas fa-list"></i> All Transactions</a>
        <div style="flex:1"></div>
        <a href="/auth/logout" class="menu-item" style="color: #ef4444;"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>

    <div class="main-content">
        <h2>Server Management</h2>
        <p>Selamat datang, Administrator <%= user.nama %></p>
        
        <div class="server-status" style="margin: 20px 0;">
            <h3><i class="fas fa-server"></i> Server Status: <span style="color: #34d399;">ONLINE</span></h3>
            <p>Node.js Environment: Development</p>
            <p>Database: MySQL Connected</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div>Total User</div>
                <div class="stat-value"><%= stats.totalUsers %></div>
            </div>
            <div class="stat-card">
                <div>Total Transaksi</div>
                <div class="stat-value"><%= stats.totalTransactions %></div>
            </div>
            <div class="stat-card">
                <div>Total Saldo Uang</div>
                <div class="stat-value" style="color: #10b981;">Rp <%= parseInt(stats.totalBalance).toLocaleString('id-ID') %></div>
            </div>
        </div>

        <div style="background: #374151; padding: 20px; border-radius: 8px;">
            <h3>Daftar User Terbaru</h3>
            <p>Fitur manajemen user detail akan ditambahkan di sini...</p>
        </div>
    </div>
</body>
</html>