<!-- views/reports.ejs -->
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Laporan Keuangan - CekUangku</title>
    <link rel="icon" type="image/png" href="/images/asset-avatar/Main.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        /* =============================================
           REPORTS — PREMIUM MODERN DESIGN
           ============================================= */
        :root {
            --primary: #4361ee;
            --primary-dark: #3730a3;
            --accent: #06b6d4;
            --success: #10b981;
            --success-light: #d1fae5;
            --danger: #ef4444;
            --danger-light: #fee2e2;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --info: #6366f1;
            --info-light: #e0e7ff;
            --bg: #f0f2f5;
            --card-bg: #ffffff;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --border: #e2e8f0;
            --sidebar-w: 260px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text-primary); display: flex; height: 100vh; overflow: hidden; }

        /* ---- SIDEBAR ---- */
        .sidebar {
            width: var(--sidebar-w);
            background: var(--card-bg);
            height: 100vh;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--border);
            position: fixed;
            left: 0; top: 0; z-index: 100;
            transition: transform .3s ease;
        }

        .sidebar-brand {
            padding: 24px 24px 20px;
            display: flex; align-items: center; gap: 12px;
            border-bottom: 1px solid var(--border);
        }

        .sidebar-brand .brand-icon {
            width: 52px; height: 52px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1.1rem;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .sidebar-brand .brand-name {
            font-size: 1.25rem; font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .sidebar-nav { flex: 1; padding: 16px 12px; overflow-y: auto; }

        .nav-label {
            font-size: 0.7rem; font-weight: 600; text-transform: uppercase;
            letter-spacing: 1.2px; color: var(--text-muted);
            padding: 12px 16px 8px;
        }

        .nav-link {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 16px; border-radius: 10px;
            color: var(--text-secondary); text-decoration: none;
            font-size: 0.9rem; font-weight: 500;
            transition: all .2s ease; margin-bottom: 2px;
        }

        .nav-link:hover { background: #f1f5f9; color: var(--primary); }
        .nav-link.active {
            background: linear-gradient(135deg, rgba(67, 97, 238, 0.1), rgba(6, 182, 212, 0.05));
            color: var(--primary); font-weight: 600;
        }
        .nav-link i { width: 20px; text-align: center; font-size: 1rem; }

        .sidebar-footer { padding: 16px 16px 20px; border-top: 1px solid var(--border); }

        .user-card {
            display: flex; align-items: center; gap: 12px;
            padding: 12px; background: #f8fafc; border-radius: 12px;
        }

        .user-avatar {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            color: white; font-weight: 700; font-size: 1rem;
        }

        .user-info { flex: 1; }
        .user-info .name { font-weight: 600; font-size: 0.85rem; color: var(--text-primary); }
        .user-info .status { font-size: 0.75rem; color: var(--success); display: flex; align-items: center; gap: 4px; }
        .user-info .status::before { content: ''; width: 6px; height: 6px; background: var(--success); border-radius: 50%; }

        .btn-logout { color: var(--text-muted); text-decoration: none; font-size: 1rem; transition: color .2s; }
        .btn-logout:hover { color: var(--danger); }

        /* ---- MAIN ---- */
        .main-area { margin-left: var(--sidebar-w); flex: 1; overflow-y: auto; overflow-x: hidden; }

        .top-header {
            background: var(--card-bg);
            padding: 20px 32px;
            border-bottom: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; z-index: 50;
        }

        .page-title h2 { font-size: 1.35rem; font-weight: 700; color: var(--text-primary); }
        .page-title p { font-size: 0.85rem; color: var(--text-secondary); margin-top: 2px; }

        .header-actions { display: flex; align-items: center; gap: 12px; }

        .btn-action {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 10px 20px; border-radius: 10px;
            font-size: 0.85rem; font-weight: 600; font-family: 'Inter', sans-serif;
            cursor: pointer; transition: all .2s; border: none;
        }

        .btn-primary-sm {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: white;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.25);
        }
        .btn-primary-sm:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(67, 97, 238, 0.35); }

        .content-area { padding: 28px 32px; }

        /* ---- SUMMARY CARDS ---- */
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .summary-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid var(--border);
            position: relative;
            overflow: hidden;
            transition: all .3s ease;
        }

        .summary-card::before {
            content: ''; position: absolute; top: 0; left: 0;
            width: 100%; height: 3px;
        }

        .summary-card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px -8px rgba(0,0,0,0.1); }
        .summary-card.income-card::before { background: linear-gradient(90deg, var(--success), #34d399); }
        .summary-card.expense-card::before { background: linear-gradient(90deg, var(--danger), #fb923c); }
        .summary-card.balance-card::before { background: linear-gradient(90deg, var(--primary), var(--accent)); }

        .summary-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }

        .summary-label { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); }

        .summary-icon {
            width: 44px; height: 44px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
        }

        .summary-icon.green { background: var(--success-light); color: var(--success); }
        .summary-icon.red { background: var(--danger-light); color: var(--danger); }
        .summary-icon.blue { background: var(--info-light); color: var(--primary); }

        .summary-value { font-size: 1.5rem; font-weight: 800; color: var(--text-primary); }
        .summary-sub { font-size: 0.8rem; color: var(--text-muted); margin-top: 4px; }

        /* ---- CHARTS ---- */
        .chart-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 20px;
            margin-bottom: 28px;
        }

        .card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid var(--border);
        }

        .card-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 20px;
        }

        .card-title { font-size: 1rem; font-weight: 700; color: var(--text-primary); }
        .card-subtitle { font-size: 0.8rem; color: var(--text-muted); }

        .chart-wrap { position: relative; height: 300px; }

        /* ---- CATEGORY TABLE ---- */
        .category-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 28px;
        }

        .cat-table { width: 100%; border-collapse: collapse; }
        .cat-table th {
            text-align: left; padding: 12px 0;
            font-size: 0.78rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: 0.5px;
            color: var(--text-muted);
            border-bottom: 2px solid var(--border);
        }
        .cat-table td {
            padding: 14px 0;
            border-bottom: 1px solid #f1f5f9;
            font-size: 0.9rem;
            color: var(--text-primary);
        }

        .cat-name-cell { display: flex; align-items: center; gap: 10px; }
        .cat-dot {
            width: 10px; height: 10px; border-radius: 50%;
        }

        .cat-amount { font-weight: 700; }
        .cat-count { color: var(--text-muted); font-size: 0.85rem; }

        /* ---- TRANSACTION HISTORY ---- */
        .trans-table { width: 100%; border-collapse: collapse; }
        .trans-table th {
            text-align: left; padding: 12px 16px;
            font-size: 0.78rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: 0.5px;
            color: var(--text-muted);
            background: #f8fafc;
            border-bottom: 2px solid var(--border);
        }
        .trans-table th:first-child { border-radius: 8px 0 0 0; }
        .trans-table th:last-child { border-radius: 0 8px 0 0; }

        .trans-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #f1f5f9;
            font-size: 0.9rem;
        }

        .trans-table tr:hover { background: #fafbfc; }

        .type-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .type-badge.income { background: var(--success-light); color: var(--success); }
        .type-badge.expense { background: var(--danger-light); color: var(--danger); }

        .amount-text { font-weight: 700; }
        .amount-text.positive { color: var(--success); }
        .amount-text.negative { color: var(--danger); }

        /* Empty State */
        .empty-state {
            text-align: center; padding: 60px 20px;
        }

        .empty-state i {
            font-size: 3rem; color: var(--text-muted); opacity: 0.4; margin-bottom: 16px;
        }

        .empty-state h3 { font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 8px; }
        .empty-state p { color: var(--text-muted); font-size: 0.85rem; }

        .empty-state .btn-cta {
            display: inline-block; margin-top: 16px;
            padding: 10px 24px; background: linear-gradient(135deg, var(--primary), var(--accent));
            color: white; border-radius: 10px; text-decoration: none;
            font-weight: 600; font-size: 0.85rem;
            transition: transform .2s, box-shadow .2s;
        }

        .empty-state .btn-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(67, 97, 238, 0.3); }

        /* ---- ANIMATIONS ---- */
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .summary-card { animation: slideUp .5s ease forwards; }
        .summary-card:nth-child(1) { animation-delay: .05s; }
        .summary-card:nth-child(2) { animation-delay: .1s; }
        .summary-card:nth-child(3) { animation-delay: .15s; }
        .chart-grid { animation: slideUp .5s ease .2s forwards; opacity: 0; }
        .category-grid { animation: slideUp .5s ease .25s forwards; opacity: 0; }

        /* ---- RESPONSIVE ---- */
        @media (max-width: 1200px) { .summary-grid { grid-template-columns: 1fr; } }

        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); box-shadow: 4px 0 20px rgba(0,0,0,0.1); }
            .main-area { margin-left: 0; }
            .chart-grid { grid-template-columns: 1fr; }
            .category-grid { grid-template-columns: 1fr; }
            .menu-toggle { display: block !important; }
        }

        @media (max-width: 600px) {
            .content-area { padding: 20px 16px; }
            .top-header { padding: 16px; flex-direction: column; gap: 12px; align-items: flex-start; }
            .trans-table { font-size: 0.8rem; }
        }

        .menu-toggle { display: none; background: none; border: none; cursor: pointer; padding: 8px; border-radius: 8px; color: var(--text-secondary); }
        .menu-toggle:hover { background: #f1f5f9; }

        /* ---- EXPORT PDF MODAL ---- */
        .modal-overlay {
            display: none;
            position: fixed; inset: 0; z-index: 1000;
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(5px);
            align-items: center; justify-content: center;
        }
        .modal-overlay.active { display: flex; animation: pdf-fadeIn .2s ease; }

        @keyframes pdf-fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes pdf-modalSlide { from { opacity: 0; transform: translateY(24px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }

        .pdf-modal-box {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 32px;
            width: 100%;
            max-width: 460px;
            box-shadow: 0 24px 48px -12px rgba(0,0,0,0.22);
            animation: pdf-modalSlide .25s ease;
        }

        .pdf-modal-header {
            display: flex; justify-content: space-between; align-items: flex-start;
            margin-bottom: 24px;
        }

        .pdf-modal-title-wrap .pdf-modal-icon {
            width: 48px; height: 48px;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1.2rem;
            margin-bottom: 12px;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.35);
        }

        .pdf-modal-title-wrap h3 {
            font-size: 1.15rem; font-weight: 700; color: var(--text-primary);
        }

        .pdf-modal-title-wrap p {
            font-size: 0.82rem; color: var(--text-secondary); margin-top: 4px;
        }

        .pdf-modal-close {
            background: #f1f5f9; border: none; cursor: pointer;
            width: 36px; height: 36px; border-radius: 10px;
            color: var(--text-muted); font-size: 1rem;
            display: flex; align-items: center; justify-content: center;
            transition: all .2s; flex-shrink: 0;
        }
        .pdf-modal-close:hover { background: var(--danger-light); color: var(--danger); }

        .pdf-modal-divider {
            display: flex; align-items: center; gap: 10px;
            margin: 20px 0;
            color: var(--text-muted); font-size: 0.75rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: .5px;
        }
        .pdf-modal-divider::before, .pdf-modal-divider::after {
            content: ''; flex: 1; height: 1px; background: var(--border);
        }

        .pdf-export-option-card {
            border: 2px solid var(--border);
            border-radius: 14px;
            padding: 18px 20px;
            transition: all .2s;
            cursor: pointer;
            margin-bottom: 12px;
        }
        .pdf-export-option-card:hover { border-color: var(--danger); background: rgba(239, 68, 68, 0.03); }

        .pdf-export-option-card .opt-head {
            display: flex; align-items: center; gap: 12px;
            margin-bottom: 4px;
        }

        .pdf-export-option-card .opt-icon {
            width: 36px; height: 36px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.95rem; flex-shrink: 0;
        }

        .pdf-opt-icon-red { background: var(--danger-light); color: var(--danger); }
        .pdf-opt-icon-blue { background: var(--info-light); color: var(--primary); }

        .pdf-export-option-card .opt-title { font-weight: 700; font-size: 0.9rem; color: var(--text-primary); }
        .pdf-export-option-card .opt-desc { font-size: 0.78rem; color: var(--text-muted); margin-left: 48px; }

        .pdf-date-range-form { display: none; margin-top: 14px; }
        .pdf-date-range-form.visible { display: block; }

        .pdf-date-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        .pdf-form-label {
            display: block;
            font-size: 0.82rem; font-weight: 600;
            color: #1e293b; margin-bottom: 6px;
        }

        .pdf-form-input {
            width: 100%; padding: 11px 14px;
            border: 1.5px solid var(--border);
            border-radius: 10px; font-size: 0.85rem;
            font-family: 'Inter', sans-serif;
            color: #1e293b; background: #fafbfc;
            outline: none; transition: all .2s;
            color-scheme: light;
        }
        .pdf-form-input:focus { border-color: var(--primary); background: white; box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1); }
        .pdf-form-input::-webkit-calendar-picker-indicator { filter: none; cursor: pointer; }

        .btn-pdf-export-modal {
            width: 100%; padding: 13px;
            border: none; border-radius: 12px;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem; font-weight: 700;
            cursor: pointer; transition: all .3s;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            color: white;
        }

        .btn-pdf-export-modal.red {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
            margin-top: 16px;
        }
        .btn-pdf-export-modal.red:hover { box-shadow: 0 8px 20px rgba(239, 68, 68, 0.45); transform: translateY(-1px); }

        .btn-pdf-export-modal.indigo {
            background: linear-gradient(135deg, var(--primary), #6366f1);
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
            margin-top: 8px;
        }
        .btn-pdf-export-modal.indigo:hover { box-shadow: 0 8px 20px rgba(67, 97, 238, 0.4); transform: translateY(-1px); }

        /* ---- PDF PROGRESS OVERLAY ---- */
        @keyframes pdf-iconPulse {
            0%, 100% { box-shadow: 0 8px 24px rgba(239,68,68,0.35); transform: scale(1); }
            50% { box-shadow: 0 12px 32px rgba(239,68,68,0.55); transform: scale(1.05); }
        }

        @keyframes pdf-shimmerBar {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        .pdf-exp-step.done .pdf-exp-step-dot {
            background: linear-gradient(135deg, #ef4444, #dc2626) !important;
        }
        .pdf-exp-step.done .pdf-exp-step-dot i {
            color: white !important;
        }
        .pdf-exp-step.active {
            opacity: 1 !important;
            transform: translateX(0) !important;
        }
        .pdf-exp-step.active .pdf-exp-step-dot {
            background: var(--danger-light) !important;
            box-shadow: 0 0 0 3px rgba(239,68,68,0.15);
        }
        .pdf-exp-step.active .pdf-exp-step-dot i {
            color: var(--danger) !important;
        }
    </style>
</head>
<body>

    <!-- ===== SIDEBAR ===== -->
    <!-- ===== SIDEBAR ===== -->
    <%- include('partials/sidebar', { activeMenu: 'reports' }) %>

    <!-- ===== MAIN AREA ===== -->
    <main class="main-area">
        <!-- Top Header -->
        <header class="top-header">
            <div style="display:flex;align-items:center;gap:12px;">
                <button class="menu-toggle" onclick="document.getElementById('sidebar').classList.toggle('open')">
                    <i class="fas fa-bars" style="font-size:1.2rem;"></i>
                </button>
                <div class="page-title">
                    <h2><i class="fas fa-chart-bar" style="color:var(--primary);margin-right:8px;"></i>Laporan Keuangan</h2>
                    <p>Analisis lengkap pemasukan dan pengeluaran kamu</p>
                </div>
            </div>
            <div class="header-actions" style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button class="btn-action" style="display:none; background: var(--border); color: var(--text-primary); border: 1px solid var(--border);" onclick="window.print()">
                    <i class="fas fa-print"></i> Cetak Layar
                </button>
                <button id="btn-export-pdf" class="btn-action btn-primary-sm" onclick="exportToPDF()">
                    <i class="fas fa-file-pdf"></i> Unduh PDF Premium
                </button>
            </div>
        </header>

        <div class="content-area">

            <%
                const tIncome = parseFloat(totals.totalIncome) || 0;
                const tExpense = parseFloat(totals.totalExpense) || 0;
                const tBalance = tIncome - tExpense;
                const tCount = totals.totalTransactions || 0;
            %>

            <!-- SUMMARY CARDS -->
            <div class="summary-grid">
                <div class="summary-card income-card">
                    <div class="summary-top">
                        <span class="summary-label">Total Pemasukan</span>
                        <div class="summary-icon green"><i class="fas fa-arrow-down"></i></div>
                    </div>
                    <div class="summary-value">Rp <%= tIncome.toLocaleString('id-ID') %></div>
                    <div class="summary-sub"><%= tCount %> transaksi tercatat</div>
                </div>

                <div class="summary-card expense-card">
                    <div class="summary-top">
                        <span class="summary-label">Total Pengeluaran</span>
                        <div class="summary-icon red"><i class="fas fa-arrow-up"></i></div>
                    </div>
                    <div class="summary-value">Rp <%= tExpense.toLocaleString('id-ID') %></div>
                    <div class="summary-sub">
                        <% if (tIncome > 0) { %>
                            <%= Math.round((tExpense / tIncome) * 100) %>% dari pemasukan
                        <% } else { %>
                            -
                        <% } %>
                    </div>
                </div>

                <div class="summary-card balance-card">
                    <div class="summary-top">
                        <span class="summary-label">Saldo Bersih</span>
                        <div class="summary-icon blue"><i class="fas fa-wallet"></i></div>
                    </div>
                    <div class="summary-value"><%= tBalance >= 0 ? '' : '-' %>Rp <%= Math.abs(tBalance).toLocaleString('id-ID') %></div>
                    <div class="summary-sub" style="color: <%= tBalance >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
                        <i class="fas fa-<%= tBalance >= 0 ? 'arrow-up' : 'arrow-down' %>"></i>
                        <%= tBalance >= 0 ? 'Keuangan sehat' : 'Pengeluaran melebihi pemasukan' %>
                    </div>
                </div>
            </div>

            <!-- CHARTS -->
            <div class="chart-grid">
                <!-- Line Chart: Monthly Trend -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">Tren Keuangan Bulanan</div>
                            <div class="card-subtitle">Income vs Expense per bulan</div>
                        </div>
                    </div>
                    <div class="chart-wrap">
                        <% if (monthlyData.length > 0) { %>
                            <canvas id="trendChart"></canvas>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="fas fa-chart-line"></i>
                                <h3>Belum ada data</h3>
                                <p>Tambahkan transaksi untuk melihat tren</p>
                                <a href="/transactions" class="btn-cta"><i class="fas fa-plus"></i> Tambah Transaksi</a>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Bar Chart: Category Expense -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">Pengeluaran per Kategori</div>
                            <div class="card-subtitle">Distribusi pengeluaranmu</div>
                        </div>
                    </div>
                    <div class="chart-wrap" style="display:flex;align-items:center;justify-content:center;">
                        <% if (categoryExpense.length > 0) { %>
                            <canvas id="categoryChart"></canvas>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="fas fa-chart-pie"></i>
                                <h3>Belum ada data</h3>
                                <p>Tambahkan pengeluaran untuk melihat chart</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- CATEGORY BREAKDOWN TABLE -->
            <% if (categoryExpense.length > 0 || categoryIncome.length > 0) { %>
            <div class="category-grid">
                <!-- Expense Categories -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title" style="color:var(--danger);">
                                <i class="fas fa-arrow-up" style="margin-right: 6px;"></i>Rincian Pengeluaran
                            </div>
                        </div>
                    </div>
                    <% if (categoryExpense.length > 0) { %>
                        <table class="cat-table">
                            <thead><tr><th>Kategori</th><th>Jumlah</th><th>Transaksi</th></tr></thead>
                            <tbody>
                                <% const expColors = ['#ef4444','#f97316','#f59e0b','#8b5cf6','#ec4899','#14b8a6','#6366f1','#64748b']; %>
                                <% categoryExpense.forEach(function(c, i) { %>
                                    <tr>
                                        <td>
                                            <div class="cat-name-cell">
                                                <span class="cat-dot" style="background:<%= expColors[i % expColors.length] %>;"></span>
                                                <%= c.category || 'Lainnya' %>
                                            </div>
                                        </td>
                                        <td class="cat-amount" style="color:var(--danger);">Rp <%= parseInt(c.total).toLocaleString('id-ID') %></td>
                                        <td class="cat-count"><%= c.count %>x</td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p style="color:var(--text-muted);text-align:center;padding:20px;">Belum ada data</p>
                    <% } %>
                </div>

                <!-- Income Categories -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title" style="color:var(--success);">
                                <i class="fas fa-arrow-down" style="margin-right: 6px;"></i>Rincian Pemasukan
                            </div>
                        </div>
                    </div>
                    <% if (categoryIncome.length > 0) { %>
                        <table class="cat-table">
                            <thead><tr><th>Kategori</th><th>Jumlah</th><th>Transaksi</th></tr></thead>
                            <tbody>
                                <% const incColors = ['#10b981','#06b6d4','#4361ee','#8b5cf6','#f59e0b','#ec4899','#14b8a6','#64748b']; %>
                                <% categoryIncome.forEach(function(c, i) { %>
                                    <tr>
                                        <td>
                                            <div class="cat-name-cell">
                                                <span class="cat-dot" style="background:<%= incColors[i % incColors.length] %>;"></span>
                                                <%= c.category || 'Lainnya' %>
                                            </div>
                                        </td>
                                        <td class="cat-amount" style="color:var(--success);">Rp <%= parseInt(c.total).toLocaleString('id-ID') %></td>
                                        <td class="cat-count"><%= c.count %>x</td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p style="color:var(--text-muted);text-align:center;padding:20px;">Belum ada data</p>
                    <% } %>
                </div>
            </div>
            <% } %>

            <!-- TRANSACTION HISTORY -->
            <div class="card" style="animation: slideUp .5s ease .3s forwards; opacity: 0;">
                <div class="card-header">
                    <div>
                        <div class="card-title">Riwayat Transaksi</div>
                        <div class="card-subtitle">20 transaksi terakhir</div>
                    </div>
                    <a href="/transactions" style="color:var(--primary);font-size:0.85rem;font-weight:600;text-decoration:none;">
                        Kelola <i class="fas fa-arrow-right" style="font-size:0.7rem;"></i>
                    </a>
                </div>

                <% if (transactions.length > 0) { %>
                    <div style="overflow-x:auto;">
                        <table class="trans-table">
                            <thead>
                                <tr>
                                    <th>Deskripsi</th>
                                    <th>Kategori</th>
                                    <th>Tanggal</th>
                                    <th>Tipe</th>
                                    <th style="text-align:right;">Jumlah</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% transactions.forEach(function(t) { %>
                                    <tr>
                                        <td style="font-weight:600;"><%= t.description %></td>
                                        <td><%= t.category || 'Lainnya' %></td>
                                        <td style="color:var(--text-muted);"><%= new Date(t.date).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) %></td>
                                        <td><span class="type-badge <%= t.type %>"><%= t.type === 'income' ? 'Pemasukan' : 'Pengeluaran' %></span></td>
                                        <td style="text-align:right;">
                                            <span class="amount-text <%= t.type === 'income' ? 'positive' : 'negative' %>">
                                                <%= t.type === 'income' ? '+' : '-' %> Rp <%= parseInt(t.amount).toLocaleString('id-ID') %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <h3>Belum ada transaksi</h3>
                        <p>Mulai catat pemasukan dan pengeluaranmu</p>
                        <a href="/transactions" class="btn-cta"><i class="fas fa-plus"></i> Tambah Transaksi</a>
                    </div>
                <% } %>
            </div>

        </div>
    </main>

    <script>
        const chartColors = ['#4361ee', '#06b6d4', '#8b5cf6', '#f59e0b', '#10b981', '#ef4444', '#ec4899', '#14b8a6'];

        <% if (monthlyData.length > 0) { %>
        // === TREND CHART ===
        (function() {
            const rawData = <%- JSON.stringify(monthlyData) %>;
            const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
            
            const monthMap = {};
            rawData.forEach(function(r) {
                const key = r.year + '-' + String(r.month).padStart(2, '0');
                if (!monthMap[key]) monthMap[key] = { label: monthNames[r.month] + ' ' + r.year, income: 0, expense: 0 };
                if (r.type === 'income') monthMap[key].income = parseFloat(r.total);
                if (r.type === 'expense') monthMap[key].expense = parseFloat(r.total);
            });

            const sorted = Object.keys(monthMap).sort();
            const labels = sorted.map(function(k) { return monthMap[k].label; });
            const incomeData = sorted.map(function(k) { return monthMap[k].income; });
            const expenseData = sorted.map(function(k) { return monthMap[k].expense; });

            new Chart(document.getElementById('trendChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Pemasukan',
                            data: incomeData,
                            backgroundColor: 'rgba(16, 185, 129, 0.8)',
                            borderColor: '#10b981',
                            borderWidth: 1,
                            borderRadius: 6,
                            barPercentage: 0.6,
                            categoryPercentage: 0.7
                        },
                        {
                            label: 'Pengeluaran',
                            data: expenseData,
                            backgroundColor: 'rgba(239, 68, 68, 0.8)',
                            borderColor: '#ef4444',
                            borderWidth: 1,
                            borderRadius: 6,
                            barPercentage: 0.6,
                            categoryPercentage: 0.7
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { position: 'top', labels: { usePointStyle: true, pointStyle: 'circle', padding: 20, font: { size: 12, family: 'Inter' } } },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            titleFont: { family: 'Inter', size: 13 },
                            bodyFont: { family: 'Inter', size: 12 },
                            padding: 12, cornerRadius: 8,
                            callbacks: { label: function(ctx) { return ctx.dataset.label + ': Rp ' + ctx.parsed.y.toLocaleString('id-ID'); } }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false },
                            ticks: { font: { family: 'Inter', size: 11 }, color: '#94a3b8', callback: function(v) { return 'Rp ' + (v/1000000).toFixed(1) + 'jt'; } }
                        },
                        x: { grid: { display: false }, ticks: { font: { family: 'Inter', size: 11 }, color: '#94a3b8' } }
                    }
                }
            });
        })();
        <% } %>

        <% if (categoryExpense.length > 0) { %>
        // === CATEGORY DOUGHNUT ===
        (function() {
            const rawCat = <%- JSON.stringify(categoryExpense) %>;
            const labels = rawCat.map(function(c) { return c.category || 'Lainnya'; });
            const data = rawCat.map(function(c) { return parseFloat(c.total); });
            const colors = chartColors.slice(0, labels.length);

            new Chart(document.getElementById('categoryChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{ data: data, backgroundColor: colors, borderWidth: 0, hoverOffset: 8 }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 16, font: { family: 'Inter', size: 11 } } },
                        tooltip: {
                            backgroundColor: '#1e293b', padding: 12, cornerRadius: 8,
                            callbacks: {
                                label: function(ctx) {
                                    const total = ctx.dataset.data.reduce(function(a, b) { return a + b; }, 0);
                                    const pct = Math.round((ctx.parsed / total) * 100);
                                    return ctx.label + ': Rp ' + ctx.parsed.toLocaleString('id-ID') + ' (' + pct + '%)';
                                }
                            }
                        }
                    }
                }
            });
        })();
        <% } %>

        // === PREMIUM PDF EXPORT FUNCTION — membuka modal pilihan ===
        function exportToPDF() {
            openPdfExportModal();
        }

        // =============================================
        // PDF EXPORT MODAL LOGIC
        // =============================================
        function openPdfExportModal() {
            document.getElementById('pdfExportModal').classList.add('active');
            // Reset state
            document.getElementById('pdfDateRangeForm').classList.remove('visible');
            document.getElementById('pdfDateRangeCard').style.borderColor = '';
            document.getElementById('pdfDateRangeCard').style.background = '';
            document.getElementById('pdfExportStartDate').value = '';
            document.getElementById('pdfExportEndDate').value = '';
        }

        function closePdfExportModalBtn() {
            document.getElementById('pdfExportModal').classList.remove('active');
        }

        function closePdfExportModal(e) {
            if (e.target === document.getElementById('pdfExportModal')) {
                closePdfExportModalBtn();
            }
        }

        function togglePdfDateRange() {
            const form = document.getElementById('pdfDateRangeForm');
            const card = document.getElementById('pdfDateRangeCard');
            const isVisible = form.classList.contains('visible');
            if (isVisible) {
                form.classList.remove('visible');
                card.style.borderColor = '';
                card.style.background = '';
            } else {
                form.classList.add('visible');
                card.style.borderColor = 'var(--primary)';
                card.style.background = 'rgba(67, 97, 238, 0.03)';
                // Default: bulan ini
                const now = new Date();
                const firstDay = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().split('T')[0];
                const today = now.toISOString().split('T')[0];
                document.getElementById('pdfExportStartDate').value = firstDay;
                document.getElementById('pdfExportEndDate').value = today;
            }
        }

        // =============================================
        // PDF PROGRESS OVERLAY ENGINE
        // =============================================
        const PDF_PROGRESS_STEPS = [
            { id: 'pdfExpStep1', title: 'Menyiapkan Data Laporan...', subtitle: 'Mengambil data transaksi dari server', pct: 20 },
            { id: 'pdfExpStep2', title: 'Membangun Struktur PDF...', subtitle: 'Menyusun halaman dan layout laporan', pct: 50 },
            { id: 'pdfExpStep3', title: 'Menerapkan Desain Premium...', subtitle: 'Memperindah grafik, warna, dan tipografi', pct: 80 },
            { id: 'pdfExpStep4', title: 'Mengunduh File PDF...', subtitle: 'File laporan sedang dikirim ke perangkat Anda', pct: 100 },
        ];

        function setPdfProgress(pct, title, subtitle) {
            document.getElementById('pdfExpProgressFill').style.width = pct + '%';
            document.getElementById('pdfExpPercent').textContent = pct + '%';
            document.getElementById('pdfExpTitle').textContent = title;
            document.getElementById('pdfExpSubtitle').textContent = subtitle;
        }

        function activatePdfStep(index) {
            for (let i = 0; i < index; i++) {
                const el = document.getElementById(PDF_PROGRESS_STEPS[i].id);
                el.classList.remove('active');
                el.classList.add('done');
                el.style.opacity = '1';
                el.style.transform = 'translateX(0)';
            }
            const cur = document.getElementById(PDF_PROGRESS_STEPS[index].id);
            cur.classList.add('active');
        }

        function showPdfProgressOverlay() {
            PDF_PROGRESS_STEPS.forEach(function(s) {
                const el = document.getElementById(s.id);
                el.classList.remove('active', 'done');
                el.style.opacity = '0.35';
                el.style.transform = 'translateX(-4px)';
            });
            document.getElementById('pdfExpProgressFill').style.width = '0%';
            document.getElementById('pdfExpPercent').textContent = '0%';
            document.getElementById('pdfExportProgressOverlay').style.display = 'flex';
        }

        function hidePdfProgressOverlay() {
            document.getElementById('pdfExportProgressOverlay').style.display = 'none';
        }

        function runPdfProgressAndDownload(downloadUrl) {
            closePdfExportModalBtn();
            showPdfProgressOverlay();

            const timings = [300, 900, 1600, 2400];

            PDF_PROGRESS_STEPS.forEach(function(step, i) {
                setTimeout(function() {
                    setPdfProgress(step.pct, step.title, step.subtitle);
                    activatePdfStep(i);

                    if (i === PDF_PROGRESS_STEPS.length - 1) {
                        setTimeout(function() {
                            const last = document.getElementById(step.id);
                            last.classList.remove('active');
                            last.classList.add('done');
                            last.style.opacity = '1';

                            const anchor = document.createElement('a');
                            anchor.href = downloadUrl;
                            anchor.style.display = 'none';
                            document.body.appendChild(anchor);
                            anchor.click();
                            document.body.removeChild(anchor);

                            setTimeout(hidePdfProgressOverlay, 900);
                        }, 500);
                    }
                }, timings[i]);
            });
        }

        // Ekspor semua data
        function pdfExportAllData() {
            runPdfProgressAndDownload('/reports/export-pdf');
        }

        async function pdfExportByDateRange() {
            const start = document.getElementById('pdfExportStartDate').value;
            const end = document.getElementById('pdfExportEndDate').value;

            if (!start || !end) {
                await CekUangkuDialog.alert('Harap isi kedua tanggal terlebih dahulu!', 'Peringatan', 'warning');
                return;
            }

            if (new Date(start) > new Date(end)) {
                await CekUangkuDialog.alert('Tanggal mulai tidak boleh lebih dari tanggal selesai!', 'Peringatan', 'warning');
                return;
            }

            runPdfProgressAndDownload(`/reports/export-pdf?start_date=${start}&end_date=${end}`);
        }
    </script>

    <!-- ====================================================
         PDF PROGRESS OVERLAY
         ==================================================== -->
    <div id="pdfExportProgressOverlay" style="
        display: none;
        position: fixed; inset: 0; z-index: 2000;
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(8px);
        align-items: center; justify-content: center;
        animation: pdf-fadeIn .25s ease;
    ">
        <div style="
            background: var(--card-bg);
            border-radius: 24px;
            padding: 40px 36px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 32px 64px -12px rgba(0,0,0,0.25), 0 0 0 1px rgba(255,255,255,.05);
            text-align: center;
            animation: pdf-modalSlide .3s cubic-bezier(.34,1.56,.64,1);
        ">
            <!-- Icon Pulsing -->
            <div style="
                width: 72px; height: 72px;
                background: linear-gradient(135deg, #ef4444, #dc2626);
                border-radius: 20px;
                display: flex; align-items: center; justify-content: center;
                margin: 0 auto 20px;
                font-size: 1.8rem; color: white;
                box-shadow: 0 8px 24px rgba(239,68,68,0.35);
                animation: pdf-iconPulse 1.8s ease-in-out infinite;
            ">
                <i class="fas fa-file-pdf"></i>
            </div>

            <!-- Title & Subtitle -->
            <h3 id="pdfExpTitle" style="font-size: 1.1rem; font-weight: 800; color: var(--text-primary); margin-bottom: 6px;">Menyiapkan Laporan...</h3>
            <p id="pdfExpSubtitle" style="font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 28px;">Mengambil data transaksi dari server</p>

            <!-- Progress Bar Track -->
            <div style="
                width: 100%; background: var(--border);
                border-radius: 100px; height: 10px;
                overflow: hidden; margin-bottom: 10px;
            ">
                <div id="pdfExpProgressFill" style="
                    height: 100%; width: 0%;
                    background: linear-gradient(90deg, #ef4444, #dc2626, #f87171, #ef4444);
                    background-size: 300% 100%;
                    border-radius: 100px;
                    transition: width .6s cubic-bezier(.4,0,.2,1);
                    animation: pdf-shimmerBar 2s linear infinite;
                "></div>
            </div>

            <!-- Percentage Label -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px;">
                <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 500;">Progress</span>
                <span id="pdfExpPercent" style="font-size: 0.8rem; font-weight: 700; color: #ef4444;">0%</span>
            </div>

            <!-- Step Checklist -->
            <div style="text-align: left; display: flex; flex-direction: column; gap: 10px;">
                <div class="pdf-exp-step" id="pdfExpStep1" style="display: flex; align-items: center; gap: 10px; opacity: 0.35; transition: opacity .4s, transform .4s; transform: translateX(-4px);">
                    <div class="pdf-exp-step-dot" style="width: 28px; height: 28px; border-radius: 50%; background: var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background .4s;">
                        <i class="fas fa-server" style="font-size: 0.7rem; color: var(--text-muted);"></i>
                    </div>
                    <span style="font-size: 0.82rem; color: var(--text-secondary); font-weight: 500;">Mengambil data dari server</span>
                </div>
                <div class="pdf-exp-step" id="pdfExpStep2" style="display: flex; align-items: center; gap: 10px; opacity: 0.35; transition: opacity .4s, transform .4s; transform: translateX(-4px);">
                    <div class="pdf-exp-step-dot" style="width: 28px; height: 28px; border-radius: 50%; background: var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background .4s;">
                        <i class="fas fa-file-alt" style="font-size: 0.7rem; color: var(--text-muted);"></i>
                    </div>
                    <span style="font-size: 0.82rem; color: var(--text-secondary); font-weight: 500;">Membangun struktur PDF</span>
                </div>
                <div class="pdf-exp-step" id="pdfExpStep3" style="display: flex; align-items: center; gap: 10px; opacity: 0.35; transition: opacity .4s, transform .4s; transform: translateX(-4px);">
                    <div class="pdf-exp-step-dot" style="width: 28px; height: 28px; border-radius: 50%; background: var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background .4s;">
                        <i class="fas fa-palette" style="font-size: 0.7rem; color: var(--text-muted);"></i>
                    </div>
                    <span style="font-size: 0.82rem; color: var(--text-secondary); font-weight: 500;">Menerapkan desain premium</span>
                </div>
                <div class="pdf-exp-step" id="pdfExpStep4" style="display: flex; align-items: center; gap: 10px; opacity: 0.35; transition: opacity .4s, transform .4s; transform: translateX(-4px);">
                    <div class="pdf-exp-step-dot" style="width: 28px; height: 28px; border-radius: 50%; background: var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background .4s;">
                        <i class="fas fa-download" style="font-size: 0.7rem; color: var(--text-muted);"></i>
                    </div>
                    <span style="font-size: 0.82rem; color: var(--text-secondary); font-weight: 500;">Mengunduh file PDF</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ====================================================
         MODAL EKSPOR PDF PREMIUM
         ==================================================== -->
    <div class="modal-overlay" id="pdfExportModal" onclick="closePdfExportModal(event)">
        <div class="pdf-modal-box">
            <div class="pdf-modal-header">
                <div class="pdf-modal-title-wrap">
                    <div class="pdf-modal-icon"><i class="fas fa-file-pdf"></i></div>
                    <h3>Ekspor Laporan Keuangan</h3>
                    <p>Pilih mode ekspor yang sesuai kebutuhan Anda</p>
                </div>
                <button class="pdf-modal-close" onclick="closePdfExportModalBtn()"><i class="fas fa-times"></i></button>
            </div>

            <!-- Opsi 1: Semua Data -->
            <div class="pdf-export-option-card" onclick="pdfExportAllData()">
                <div class="opt-head">
                    <div class="opt-icon pdf-opt-icon-red"><i class="fas fa-database"></i></div>
                    <div class="opt-title">Semua Data</div>
                </div>
                <div class="opt-desc">Ekspor seluruh riwayat laporan keuangan tanpa filter waktu</div>
            </div>

            <div class="pdf-modal-divider">atau</div>

            <!-- Opsi 2: Rentang Tanggal -->
            <div class="pdf-export-option-card" id="pdfDateRangeCard" onclick="togglePdfDateRange()" style="margin-bottom: 0;">
                <div class="opt-head">
                    <div class="opt-icon pdf-opt-icon-blue"><i class="fas fa-calendar-alt"></i></div>
                    <div class="opt-title">Berdasarkan Rentang Tanggal</div>
                </div>
                <div class="opt-desc">Pilih periode tertentu untuk ekspor data laporan keuangan</div>

                <!-- Form Tanggal (tersembunyi secara default) -->
                <div class="pdf-date-range-form" id="pdfDateRangeForm" onclick="event.stopPropagation()">
                    <div class="pdf-date-row" style="margin-top: 14px;">
                        <div>
                            <label class="pdf-form-label">Tanggal Mulai</label>
                            <input type="date" id="pdfExportStartDate" class="pdf-form-input">
                        </div>
                        <div>
                            <label class="pdf-form-label">Tanggal Selesai</label>
                            <input type="date" id="pdfExportEndDate" class="pdf-form-input">
                        </div>
                    </div>
                    <button class="btn-pdf-export-modal indigo" onclick="pdfExportByDateRange()">
                        <i class="fas fa-download"></i> Ekspor Rentang Waktu
                    </button>
                </div>
            </div>

        </div>
    </div>
</body>
</html>