<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen User - CekUangku</title>
    <link rel="icon" type="image/png" href="/images/asset-avatar/Main.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #3730a3;
            --secondary: #10b981;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --border: #e2e8f0;
            --sidebar-w: 260px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        body { background: var(--bg); display: flex; height: 100vh; overflow: hidden; }

        .main-area { margin-left: var(--sidebar-w); flex: 1; display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden; }
        .top-header { background: var(--card-bg); padding: 20px 32px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 10; }
        .page-title h2 { font-size: 1.35rem; font-weight: 700; color: var(--text-primary); }
        
        .content-area { padding: 32px; max-width: 1200px; margin: 0 auto; width: 100%; }

        /* ---- SIDEBAR CSS STYLES (SYNCED) ---- */
        .sidebar { width: var(--sidebar-w); background: var(--card-bg); height: 100vh; display: flex; flex-direction: column; border-right: 1px solid var(--border); position: fixed; left: 0; top: 0; z-index: 100; transition: transform .3s ease; }
        .sidebar-brand { padding: 24px 24px 20px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--border); }
        .sidebar-brand .brand-icon { width: 52px; height: 52px; background: linear-gradient(135deg, var(--primary), var(--secondary)); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.1rem; box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3); overflow: hidden; }
        .sidebar-brand .brand-name { font-size: 1.25rem; font-weight: 700; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .sidebar-nav { flex: 1; padding: 16px 12px; overflow-y: auto; }
        .nav-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1.2px; color: var(--text-secondary); padding: 12px 16px 8px; }
        .nav-link { display: flex; align-items: center; gap: 12px; padding: 11px 16px; border-radius: 10px; color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: all .2s ease; margin-bottom: 2px; }
        .nav-link:hover { background: #f1f5f9; color: var(--primary); }
        .nav-link.active { background: linear-gradient(135deg, rgba(79, 70, 229, 0.1), rgba(16, 185, 129, 0.05)); color: var(--primary); font-weight: 600; }
        .nav-link.active i { color: var(--primary); }
        .nav-link i { width: 20px; text-align: center; font-size: 1rem; }
        .sidebar-footer { padding: 16px 16px 20px; border-top: 1px solid var(--border); }
        .user-card { display: flex; align-items: center; gap: 12px; padding: 12px; background: #f8fafc; border-radius: 12px; }
        .user-avatar { width: 42px; height: 42px; background: linear-gradient(135deg, var(--primary), var(--secondary)); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1rem; overflow: hidden; }
        .user-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .user-info { flex: 1; overflow: hidden; }
        .user-info .name { font-weight: 600; font-size: 0.85rem; color: var(--text-primary); white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
        .user-info .status { font-size: 0.75rem; color: #10b981; display: flex; align-items: center; gap: 4px; }
        .user-info .status::before { content: ''; width: 6px; height: 6px; background: #10b981; border-radius: 50%; }
        .btn-logout { color: var(--text-secondary); text-decoration: none; font-size: 1rem; transition: color .2s; }
        .btn-logout:hover { color: #ef4444; }

        /* Action Bar */
        .action-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; gap: 16px; flex-wrap: wrap; }
        .search-wrapper { position: relative; flex: 1; min-width: 300px; }
        .search-wrapper i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--text-secondary); }
        .search-input { width: 100%; padding: 12px 16px 12px 48px; border-radius: 12px; border: 1px solid var(--border); background: var(--card-bg); outline: none; transition: border-color 0.2s; }
        .search-input:focus { border-color: var(--primary); }
        
        .btn-add { background: var(--primary); color: white; padding: 12px 24px; border-radius: 12px; border: none; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 10px; transition: all 0.2s; box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2); }
        .btn-add:hover { background: var(--primary-dark); transform: translateY(-2px); }

        /* Table CSS */
        .table-card { background: var(--card-bg); border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden; }
        .users-table { width: 100%; border-collapse: collapse; }
        .users-table th { background: #f8fafc; padding: 16px 24px; text-align: left; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; border-bottom: 1px solid var(--border); }
        .users-table td { padding: 16px 24px; font-size: 0.9rem; color: var(--text-primary); border-bottom: 1px solid var(--border); vertical-align: middle; }
        .users-table tr:hover td { background: #f8fafc; }

        .user-profile { display: flex; align-items: center; gap: 12px; }
        .avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--secondary)); display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; overflow: hidden; }
        .avatar img { width: 100%; height: 100%; object-fit: cover; }
        .user-name { font-weight: 600; }
        .user-email { font-size: 0.8rem; color: var(--text-secondary); }

        .badge { padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; text-transform: capitalize; }
        .badge.admin { background: #fee2e2; color: #991b1b; }
        .badge.user { background: #e0e7ff; color: #4338ca; }

        .actions-cell { display: flex; gap: 8px; }
        .btn-icon { width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--border); background: white; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; color: var(--text-secondary); }
        .btn-icon:hover { background: #f8fafc; color: var(--primary); border-color: var(--primary); }
        .btn-icon.delete:hover { border-color: #ef4444; color: #ef4444; }

        /* Modal Styles */
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: none; align-items: center; justify-content: center; padding: 20px; backdrop-filter: blur(4px); }
        .modal-overlay.active { display: flex; }
        .modal-card { background: white; width: 100%; max-width: 500px; border-radius: 20px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); animation: zoomIn 0.3s ease; }
        @keyframes zoomIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }

        .modal-header { padding: 24px; background: #f8fafc; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
        .modal-header h3 { font-size: 1.15rem; font-weight: 700; color: var(--text-primary); }
        .btn-close { background: none; border: none; font-size: 1.25rem; color: var(--text-secondary); cursor: pointer; }

        .modal-body { padding: 24px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; }
        .form-input { width: 100%; padding: 12px 16px; border-radius: 10px; border: 1px solid var(--border); outline: none; }
        .form-input:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1); }
        
        .modal-footer { padding: 24px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 12px; }
        .btn { padding: 10px 20px; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 0.9rem; transition: all 0.2s; border: none; }
        .btn-secondary { background: #f1f5f9; color: var(--text-secondary); }
        .btn-primary { background: var(--primary); color: white; }
        .btn-primary:hover { background: var(--primary-dark); }

        @media(max-width: 900px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); }
            .main-area { margin-left: 0; }
            .menu-toggle { display: block !important; }
        }
        .menu-toggle { display: none; background: none; border: none; font-size: 1.25rem; color: var(--text-primary); cursor: pointer; padding: 8px; }

        /* Toggle Switch */
        .switch { position: relative; display: inline-block; width: 42px; height: 22px; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #cbd5e1; transition: .4s; border-radius: 34px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }
        .switch input:checked + .slider { background-color: var(--secondary); }
        .switch input:checked + .slider:before { transform: translateX(20px); }

        /* Progress Overlay */
        .progress-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(10px); z-index: 10000; display: none; align-items: center; justify-content: center; animation: fadeIn 0.3s ease; }
        .progress-overlay.active { display: flex; }
        .progress-card { background: white; width: 100%; max-width: 400px; padding: 32px; border-radius: 24px; text-align: center; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
        .progress-title { font-weight: 700; margin-bottom: 8px; color: var(--text-primary); }
        .progress-subtitle { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 24px; }
        .progress-bar-container { width: 100%; height: 10px; background: #e2e8f0; border-radius: 10px; overflow: hidden; position: relative; }
        .progress-bar-fill { width: 0%; height: 100%; background: linear-gradient(90deg, #4f46e5, #06b6d4); transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1); border-radius: 10px; }
        
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body>

    <%- include('partials/sidebar', { activeMenu: 'admin_users' }) %>

    <div class="main-area">
        <div class="top-header">
            <div style="display:flex;align-items:center;gap:16px;">
                <button class="menu-toggle" onclick="document.getElementById('sidebar').classList.toggle('open')"><i class="fas fa-bars"></i></button>
                <div class="page-title">
                    <h2>👥 Manajemen User</h2>
                </div>
            </div>
            <div>
                <span style="font-size: 0.9rem; color: var(--text-secondary); font-weight: 600;"><i class="fas fa-shield-alt" style="color:var(--primary); margin-right:6px;"></i> Mode Super Administrator</span>
            </div>
        </div>

        <div class="content-area">
            
            <div class="action-bar">
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" id="userSearch" class="search-input" placeholder="Cari nama atau email pengguna...">
                </div>
                <button class="btn-add" onclick="showModal('addModal')">
                    <i class="fas fa-plus"></i> Tambah User Baru
                </button>
            </div>

            <div class="table-card">
                <table class="users-table" id="usersTable">
                    <thead>
                        <tr>
                            <th>Profil User</th>
                            <th>Role</th>
                            <th>Login Terakhir</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(function(u) { %>
                        <tr class="user-row">
                            <td>
                                <div class="user-profile">
                                    <div class="avatar">
                                        <% if (u.profile_picture) { %>
                                            <img src="<%= u.profile_picture %>">
                                        <% } else { %>
                                            <%= u.nama.charAt(0).toUpperCase() %>
                                        <% } %>
                                    </div>
                                    <div>
                                        <div class="user-name"><%= u.nama %></div>
                                        <div class="user-email"><%= u.email %></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge <%= u.role %>"><%= u.role %></span>
                            </td>
                            <td>
                                <% if (u.last_login) { %>
                                    <%= new Date(u.last_login).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                                <% } else { %>
                                    <span style="color:var(--text-secondary); font-style:italic;">Belum pernah</span>
                                <% } %>
                            </td>
                            <td>
                                <label class="switch">
                                    <input type="checkbox" <%= u.is_active ? 'checked' : '' %> onchange="toggleUserStatus('<%= u.id %>', this.checked)">
                                    <span class="slider"></span>
                                </label>
                            </td>
                            <td class="actions-cell">
                                <button class="btn-icon" title="Edit Profil" onclick="editUser('<%= u.id %>', '<%= u.nama %>', '<%= u.email %>', '<%= u.role %>')">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn-icon" title="Ganti Password" onclick="changePass('<%= u.id %>', '<%= u.nama %>')">
                                    <i class="fas fa-key"></i>
                                </button>
                                <button class="btn-icon delete" title="Hapus User" onclick="confirmDeleteUser('<%= u.id %>', '<%= u.nama %>')">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- MODAL TAMBAH USER -->
    <div class="modal-overlay" id="addModal">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Tambah Pengguna Baru</h3>
                <button class="btn-close" onclick="hideModal('addModal')">&times;</button>
            </div>
            <form action="/admin/users/add" method="POST">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Nama Lengkap</label>
                        <input type="text" name="nama" class="form-input" required placeholder="Contoh: Budi Santoso">
                    </div>
                    <div class="form-group">
                        <label>Alamat Email</label>
                        <input type="email" name="email" class="form-input" required placeholder="budi@example.com">
                    </div>
                    <div class="form-group">
                        <label>Password Awal</label>
                        <input type="password" name="password" class="form-input" required placeholder="Minimal 6 karakter">
                    </div>
                    <div class="form-group">
                        <label>Role / Hak Akses</label>
                        <select name="role" class="form-input">
                            <option value="user">Reguler User</option>
                            <option value="admin">Administrator</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="hideModal('addModal')">Batal</button>
                    <button type="submit" class="btn btn-primary">Simpan User</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL EDIT USER -->
    <div class="modal-overlay" id="editModal">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Edit Profil Pengguna</h3>
                <button class="btn-close" onclick="hideModal('editModal')">&times;</button>
            </div>
            <form id="editForm" action="" method="POST">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Nama Lengkap</label>
                        <input type="text" name="nama" id="editNama" class="form-input" required>
                    </div>
                    <div class="form-group">
                        <label>Alamat Email</label>
                        <input type="email" name="email" id="editEmail" class="form-input" required>
                    </div>
                    <div class="form-group">
                        <label>Role / Hak Akses</label>
                        <select name="role" id="editRole" class="form-input">
                            <option value="user">Reguler User</option>
                            <option value="admin">Administrator</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="hideModal('editModal')">Batal</button>
                    <button type="submit" class="btn btn-primary">Update Info</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL GANTI PASSWORD -->
    <div class="modal-overlay" id="passModal">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Reset Password User</h3>
                <button class="btn-close" onclick="hideModal('passModal')">&times;</button>
            </div>
            <form id="passForm" action="" method="POST">
                <div class="modal-body">
                    <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 16px;">Ganti password untuk: <strong id="passTargetName" style="color:var(--text-primary);"></strong></p>
                    <div class="form-group">
                        <label>Password Baru</label>
                        <input type="password" name="password" class="form-input" required placeholder="Ketik password baru pengguna">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="hideModal('passModal')">Batal</button>
                    <button type="submit" class="btn btn-primary">Reset Password</button>
                </div>
            </form>
        </div>
    </div>

    <!-- PROGRESS OVERLAY -->
    <div class="progress-overlay" id="deleteProgressOverlay">
        <div class="progress-card">
            <div class="progress-title" id="progressTitle">Sedang Memproses...</div>
            <div class="progress-subtitle" id="progressSubtitle">Membersihkan data user dari sistem</div>
            <div class="progress-bar-container">
                <div class="progress-bar-fill" id="progressBarFill"></div>
            </div>
        </div>
    </div>

    <!-- FORM HIDDEN UNTUK DELETE -->
    <form id="deleteForm" action="" method="POST" style="display:none;"></form>

    <script>
        function showModal(id) {
            document.getElementById(id).classList.add('active');
        }
        function hideModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        // Search logic
        const searchInput = document.getElementById('userSearch');
        const userRows = document.querySelectorAll('.user-row');

        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase();
            userRows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });

        // Edit trigger
        function editUser(id, nama, email, role) {
            document.getElementById('editForm').action = '/admin/users/edit/' + id;
            document.getElementById('editNama').value = nama;
            document.getElementById('editEmail').value = email;
            document.getElementById('editRole').value = role;
            showModal('editModal');
        }

        // Password trigger
        function changePass(id, nama) {
            document.getElementById('passForm').action = '/admin/users/change-password/' + id;
            document.getElementById('passTargetName').innerText = nama;
            showModal('passModal');
        }

        // Delete trigger
        // Delete trigger dengan Progress Bar
        async function confirmDeleteUser(id, nama) {
            const confirmed = await CekUangkuDialog.confirm(
                `Apakah Anda yakin ingin menghapus akun <strong>${nama}</strong>?<br><br><span style="color: #ef4444; font-size: 0.85rem;">⚠️ Tindakan ini permanen. Seluruh data transaksi, dompet, kategori, dan anggaran milik pengguna ini akan ikut terhapus dari sistem.</span>`,
                'Konfirmasi Hapus Akun',
                'delete'
            );
            
            if (confirmed) {
                const overlay = document.getElementById('deleteProgressOverlay');
                const fill = document.getElementById('progressBarFill');
                const subtitle = document.getElementById('progressSubtitle');
                
                overlay.classList.add('active');
                
                const stages = [
                    { p: 20, t: 'Menghapus data anggaran...' },
                    { p: 45, t: 'Membersihkan riwayat transaksi...' },
                    { p: 70, t: 'Menutup dompet digital...' },
                    { p: 90, t: 'Menghapus profil pengguna...' },
                    { p: 100, t: 'Selesai!' }
                ];

                for (let stage of stages) {
                    fill.style.width = stage.p + '%';
                    subtitle.innerText = stage.t;
                    await new Promise(r => setTimeout(r, 600));
                }

                // Jalankan penghapusan asli via AJAX/Form
                try {
                    const response = await fetch('/admin/users/delete/' + id, { method: 'POST' });
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        overlay.classList.remove('active');
                        alert('Gagal menghapus user.');
                    }
                } catch (e) {
                    overlay.classList.remove('active');
                    alert('Terjadi kesalahan jaringan.');
                }
            }
        }

        // Toggle Status logic
        async function toggleUserStatus(userId, isChecked) {
            try {
                const response = await fetch('/admin/users/toggle-status/' + userId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: isChecked ? 1 : 0 })
                });
                
                const result = await response.json();
                if (!result.success) {
                    alert('Gagal mengubah status: ' + result.message);
                    location.reload(); // Revert UI
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Terjadi kesalahan sistem.');
                location.reload();
            }
        }
    </script>
</body>
</html>
