<!-- views/transactions.ejs -->
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Transaksi - CekUangku</title>
    <link rel="icon" type="image/png" href="/images/asset-avatar/Main.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* =============================================
           TRANSACTIONS — PREMIUM MODERN DESIGN
           ============================================= */
        :root {
            --primary: #4361ee;
            --primary-dark: #3730a3;
            --accent: #06b6d4;
            --success: #10b981;
            --success-light: #d1fae5;
            --danger: #ef4444;
            --danger-light: #fee2e2;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --info: #6366f1;
            --info-light: #e0e7ff;
            --bg: #f0f2f5;
            --card-bg: #ffffff;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --border: #e2e8f0;
            --sidebar-w: 260px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text-primary); display: flex; height: 100vh; overflow: hidden; }

        /* ---- SIDEBAR ---- */
        .sidebar {
            width: var(--sidebar-w);
            background: var(--card-bg);
            height: 100vh;
            display: flex; flex-direction: column;
            border-right: 1px solid var(--border);
            position: fixed; left: 0; top: 0; z-index: 100;
            transition: transform .3s ease;
        }

        .sidebar-brand {
            padding: 24px 24px 20px;
            display: flex; align-items: center; gap: 12px;
            border-bottom: 1px solid var(--border);
        }

        .sidebar-brand .brand-icon {
            width: 52px; height: 52px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1.1rem;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .sidebar-brand .brand-name {
            font-size: 1.25rem; font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .sidebar-nav { flex: 1; padding: 16px 12px; overflow-y: auto; }

        .nav-label {
            font-size: 0.7rem; font-weight: 600; text-transform: uppercase;
            letter-spacing: 1.2px; color: var(--text-muted);
            padding: 12px 16px 8px;
        }

        .nav-link {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 16px; border-radius: 10px;
            color: var(--text-secondary); text-decoration: none;
            font-size: 0.9rem; font-weight: 500;
            transition: all .2s ease; margin-bottom: 2px;
        }

        .nav-link:hover { background: #f1f5f9; color: var(--primary); }
        .nav-link.active {
            background: linear-gradient(135deg, rgba(67, 97, 238, 0.1), rgba(6, 182, 212, 0.05));
            color: var(--primary); font-weight: 600;
        }
        .nav-link i { width: 20px; text-align: center; font-size: 1rem; }

        .sidebar-footer { padding: 16px 16px 20px; border-top: 1px solid var(--border); }

        .user-card {
            display: flex; align-items: center; gap: 12px;
            padding: 12px; background: #f8fafc; border-radius: 12px;
        }

        .user-avatar {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            color: white; font-weight: 700; font-size: 1rem;
        }

        .user-info { flex: 1; }
        .user-info .name { font-weight: 600; font-size: 0.85rem; color: var(--text-primary); }
        .user-info .status { font-size: 0.75rem; color: var(--success); display: flex; align-items: center; gap: 4px; }
        .user-info .status::before { content: ''; width: 6px; height: 6px; background: var(--success); border-radius: 50%; }

        .btn-logout { color: var(--text-muted); text-decoration: none; font-size: 1rem; transition: color .2s; }
        .btn-logout:hover { color: var(--danger); }

        /* ---- MAIN ---- */
        .main-area { margin-left: var(--sidebar-w); flex: 1; overflow-y: auto; overflow-x: hidden; }

        .top-header {
            background: var(--card-bg); padding: 20px 32px;
            border-bottom: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; z-index: 50;
        }

        .page-title h2 { font-size: 1.35rem; font-weight: 700; color: var(--text-primary); }
        .page-title p { font-size: 0.85rem; color: var(--text-secondary); margin-top: 2px; }

        .content-area { padding: 28px 32px; }

        /* ---- MINI STATS ---- */
        .mini-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .mini-card {
            background: var(--card-bg);
            border-radius: 14px;
            padding: 18px 20px;
            border: 1px solid var(--border);
            display: flex; align-items: center; gap: 14px;
            transition: all .3s ease;
        }

        .mini-card:hover { transform: translateY(-2px); box-shadow: 0 8px 16px -4px rgba(0,0,0,0.08); }

        .mini-icon {
            width: 44px; height: 44px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
        }

        .mini-icon.green { background: var(--success-light); color: var(--success); }
        .mini-icon.red { background: var(--danger-light); color: var(--danger); }
        .mini-icon.blue { background: var(--info-light); color: var(--primary); }

        .mini-text .mini-label { font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.3px; }
        .mini-text .mini-value { font-size: 1.15rem; font-weight: 700; color: var(--text-primary); margin-top: 2px; }

        /* ---- TRANSACTION GRID ---- */
        .trans-grid {
            display: grid;
            grid-template-columns: 380px 1fr;
            gap: 24px;
        }

        .card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid var(--border);
        }

        .card-title {
            font-size: 1rem; font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 20px;
            display: flex; align-items: center; gap: 8px;
        }

        .card-title i { color: var(--primary); }

        /* ---- FORM ---- */
        .form-group { margin-bottom: 16px; }

        .form-label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .form-input {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-size: 0.9rem;
            font-family: 'Inter', sans-serif;
            color: var(--text-primary);
            background: #fafbfc;
            outline: none;
            transition: all .2s;
        }

        .form-input:focus {
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
        }

        .form-input::placeholder { color: var(--text-muted); }

        /* Type Toggle */
        .type-toggle {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
        }

        .type-btn {
            flex: 1;
            padding: 11px;
            border: 2px solid var(--border);
            border-radius: 10px;
            background: white;
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s;
            display: flex; align-items: center; justify-content: center; gap: 6px;
            color: var(--text-secondary);
        }

        .type-btn:hover { border-color: var(--text-muted); }

        .type-btn.active-expense {
            border-color: var(--danger);
            background: var(--danger-light);
            color: var(--danger);
        }

        .type-btn.active-income {
            border-color: var(--success);
            background: var(--success-light);
            color: var(--success);
        }

        /* Amount Input */
        .amount-wrapper {
            position: relative;
        }

        .amount-wrapper .currency-label {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-weight: 700;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .amount-wrapper .form-input {
            padding-left: 40px;
            font-weight: 700;
            font-size: 1.1rem;
        }

        /* Submit Button */
        .btn-submit {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 12px;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: all .3s;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            color: white;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.3);
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.4);
        }

        .btn-submit.income-mode {
            background: linear-gradient(135deg, var(--success), #34d399);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }

        .btn-submit.income-mode:hover {
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
        }

        /* ---- TRANSACTION LIST ---- */
        .trans-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 16px;
        }

        .trans-count {
            font-size: 0.8rem; color: var(--text-muted);
            background: #f1f5f9; padding: 4px 12px; border-radius: 20px; font-weight: 600;
        }

        .trans-list { list-style: none; }

        .trans-item {
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 16px;
            border-radius: 12px;
            margin-bottom: 6px;
            transition: all .2s;
            border: 1px solid transparent;
        }

        .trans-item:hover {
            background: #f8fafc;
            border-color: var(--border);
        }

        .trans-left { display: flex; align-items: center; gap: 14px; flex: 1; }

        .trans-icon {
            width: 42px; height: 42px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .trans-icon.income-icon { background: var(--success-light); color: var(--success); }
        .trans-icon.expense-icon { background: var(--danger-light); color: var(--danger); }

        .trans-desc .desc-text { font-weight: 600; font-size: 0.9rem; color: var(--text-primary); }
        .trans-desc .desc-meta { font-size: 0.78rem; color: var(--text-muted); margin-top: 2px; }

        .trans-right { display: flex; align-items: center; gap: 12px; }

        .trans-amount { font-weight: 700; font-size: 0.95rem; text-align: right; }
        .trans-amount.positive { color: var(--success); }
        .trans-amount.negative { color: var(--danger); }

        .btn-delete {
            width: 32px; height: 32px;
            border: none;
            background: transparent;
            color: var(--text-muted);
            border-radius: 8px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all .2s;
            font-size: 0.85rem;
        }

        .btn-delete:hover { background: var(--danger-light); color: var(--danger); }

        /* ---- EMPTY STATE ---- */
        .empty-state { text-align: center; padding: 60px 20px; }
        .empty-state i { font-size: 3rem; color: var(--text-muted); opacity: 0.4; margin-bottom: 16px; }
        .empty-state h3 { font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 8px; }
        .empty-state p { color: var(--text-muted); font-size: 0.85rem; }

        /* ---- SEARCH BAR ---- */
        .search-bar {
            position: relative;
            margin-bottom: 16px;
        }

        .search-bar i {
            position: absolute;
            left: 14px; top: 50%; transform: translateY(-50%);
            color: var(--text-muted);
        }

        .search-bar input {
            width: 100%;
            padding: 10px 14px 10px 40px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            outline: none;
            background: #fafbfc;
            transition: all .2s;
        }

        .search-bar input:focus { border-color: var(--primary); background: white; }

        /* ---- ANIMATIONS ---- */
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .mini-card { animation: slideUp .4s ease forwards; }
        .mini-card:nth-child(1) { animation-delay: .05s; }
        .mini-card:nth-child(2) { animation-delay: .1s; }
        .mini-card:nth-child(3) { animation-delay: .15s; }
        .trans-grid { animation: slideUp .4s ease .2s forwards; opacity: 0; }

        /* ---- RESPONSIVE ---- */
        @media (max-width: 1100px) { .trans-grid { grid-template-columns: 1fr; } }

        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); box-shadow: 4px 0 20px rgba(0,0,0,0.1); }
            .main-area { margin-left: 0; }
            .menu-toggle { display: block !important; }
        }

        @media (max-width: 600px) {
            .content-area { padding: 20px 16px; }
            .mini-stats { grid-template-columns: 1fr; }
            .trans-grid { grid-template-columns: 1fr; }
        }

        .menu-toggle { display: none; background: none; border: none; cursor: pointer; padding: 8px; border-radius: 8px; color: var(--text-secondary); }
        .menu-toggle:hover { background: #f1f5f9; }
    </style>
</head>
<body>

    <!-- ===== SIDEBAR ===== -->
    <!-- ===== SIDEBAR ===== -->
    <%- include('partials/sidebar', { activeMenu: 'transactions' }) %>

    <!-- ===== MAIN AREA ===== -->
    <main class="main-area">
        <!-- Top Header -->
        <header class="top-header">
            <div style="display:flex;align-items:center;gap:12px;">
                <button class="menu-toggle" onclick="document.getElementById('sidebar').classList.toggle('open')">
                    <i class="fas fa-bars" style="font-size:1.2rem;"></i>
                </button>
                <div class="page-title">
                    <h2><i class="fas fa-exchange-alt" style="color:var(--primary);margin-right:8px;"></i>Kelola Transaksi</h2>
                    <p>Catat dan kelola pemasukan & pengeluaranmu</p>
                </div>
            </div>
        </header>

        <div class="content-area">

            <%
                const sIncome = parseFloat(stats.totalIncome) || 0;
                const sExpense = parseFloat(stats.totalExpense) || 0;
                const sBalance = sIncome - sExpense;
            %>

            <!-- MINI STATS -->
            <div class="mini-stats">
                <div class="mini-card">
                    <div class="mini-icon green"><i class="fas fa-arrow-down"></i></div>
                    <div class="mini-text">
                        <div class="mini-label">Total Pemasukan</div>
                        <div class="mini-value" style="color:var(--success);">Rp <%= sIncome.toLocaleString('id-ID') %></div>
                    </div>
                </div>
                <div class="mini-card">
                    <div class="mini-icon red"><i class="fas fa-arrow-up"></i></div>
                    <div class="mini-text">
                        <div class="mini-label">Total Pengeluaran</div>
                        <div class="mini-value" style="color:var(--danger);">Rp <%= sExpense.toLocaleString('id-ID') %></div>
                    </div>
                </div>
                <div class="mini-card">
                    <div class="mini-icon blue"><i class="fas fa-wallet"></i></div>
                    <div class="mini-text">
                        <div class="mini-label">Saldo</div>
                        <div class="mini-value"><%= sBalance >= 0 ? '' : '-' %>Rp <%= Math.abs(sBalance).toLocaleString('id-ID') %></div>
                    </div>
                </div>
            </div>

            <!-- MAIN GRID: Form + List -->
            <div class="trans-grid">

                <!-- FORM CARD -->
                <div class="card" style="height:fit-content;position:sticky;top:96px;">
                    <div class="card-title"><i class="fas fa-plus-circle"></i> Tambah Transaksi</div>

                    <form action="/transactions/add" method="POST" id="transForm">

                        <!-- Type Toggle -->
                        <div class="form-label">Tipe Transaksi</div>
                        <div class="type-toggle">
                            <button type="button" class="type-btn active-expense" id="btnExpense" onclick="setType('expense')">
                                <i class="fas fa-arrow-up"></i> Pengeluaran
                            </button>
                            <button type="button" class="type-btn" id="btnIncome" onclick="setType('income')">
                                <i class="fas fa-arrow-down"></i> Pemasukan
                            </button>
                        </div>
                        <input type="hidden" name="type" id="typeInput" value="expense">

                        <!-- Category -->
                        <div class="form-group">
                            <label class="form-label">Kategori</label>
                            <% if (categories && categories.length > 0) { %>
                                <select name="category" class="form-input" id="categorySelect">
                                    <% categories.forEach(function(cat) { %>
                                        <option value="<%= cat.name %>" data-type="<%= cat.type %>"><%= cat.name %></option>
                                    <% }) %>
                                </select>
                            <% } else { %>
                                <select name="category" class="form-input" id="categorySelect">
                                    <option value="Lainnya">-- Belum ada kategori --</option>
                                </select>
                                <p style="margin-top:6px;font-size:0.75rem;color:var(--text-muted);">
                                    <i class="fas fa-info-circle"></i> <a href="/categories" style="color:var(--primary);">Tambah kategori</a> terlebih dahulu
                                </p>
                            <% } %>
                        </div>

                        <!-- Wallet Source -->
                        <div class="form-group">
                            <label class="form-label">Sumber Dompet</label>
                            <% if (typeof wallets !== 'undefined' && wallets.length > 0) { %>
                                <select name="wallet_id" class="form-input" required>
                                    <% wallets.forEach(function(w) { %>
                                        <option value="<%= w.id %>" <%= w.is_default ? 'selected' : '' %>>
                                            <%= w.name %> (Rp <%= parseFloat(w.balance).toLocaleString('id-ID') %>)
                                        </option>
                                    <% }) %>
                                </select>
                            <% } else { %>
                                <div style="padding: 10px; background: var(--danger-light); color: var(--danger); border-radius: 8px; font-size: 0.85rem;">
                                    <i class="fas fa-exclamation-circle"></i> Anda belum memiliki dompet. 
                                    <a href="/wallets" style="color:var(--danger); font-weight:bold; text-decoration:underline;">Buat dompet</a> terlebih dahulu.
                                </div>
                            <% } %>
                        </div>

                        <!-- Description -->
                        <div class="form-group">
                            <label class="form-label">Deskripsi</label>
                            <input type="text" name="description" class="form-input" placeholder="Contoh: Makan siang di kantin" required>
                        </div>

                        <!-- Amount -->
                        <div class="form-group">
                            <label class="form-label">Jumlah</label>
                            <div class="amount-wrapper">
                                <span class="currency-label">Rp</span>
                                <input type="text" id="amountDisplay" class="form-input" placeholder="0" required oninput="formatRupiah(this)" autocomplete="off">
                                <input type="hidden" name="amount" id="amountRaw">
                            </div>
                        </div>

                        <button type="submit" class="btn-submit" id="submitBtn">
                            <i class="fas fa-save"></i> Simpan Transaksi
                        </button>
                    </form>
                </div>

                <!-- TRANSACTION LIST -->
                <div class="card">
                    <div class="trans-header">
                        <div class="card-title" style="margin-bottom:0;"><i class="fas fa-history"></i> Riwayat Transaksi</div>
                        <span class="trans-count"><%= transactions.length %> transaksi</span>
                    </div>

                    <!-- Search -->
                    <div class="search-bar">
                        <i class="fas fa-search"></i>
                        <input type="text" id="searchInput" placeholder="Cari transaksi..." oninput="filterTransactions()">
                    </div>

                    <% if (transactions.length > 0) { %>
                        <ul class="trans-list" id="transList">
                            <% transactions.forEach(function(t) { %>
                                <li class="trans-item" data-desc="<%= t.description.toLowerCase() %>" data-cat="<%= (t.category || '').toLowerCase() %>">
                                    <div class="trans-left">
                                        <div class="trans-icon <%= t.type === 'income' ? 'income-icon' : 'expense-icon' %>">
                                            <i class="fas fa-<%= t.type === 'income' ? 'arrow-down' : 'arrow-up' %>"></i>
                                        </div>
                                        <div class="trans-desc">
                                            <div class="desc-text"><%= t.description %></div>
                                            <div class="desc-meta">
                                                <% if (t.wallet_name) { %>
                                                <span style="display:inline-block; padding:2px 8px; border-radius:12px; background:<%= t.wallet_color ? t.wallet_color+'20' : '#f1f5f9' %>; color:<%= t.wallet_color || '#64748b' %>; font-weight:600; margin-right:4px;">
                                                    <i class="fas fa-wallet" style="margin-right:2px;"></i> <%= t.wallet_name %>
                                                </span>
                                                <% } %>
                                                <i class="fas fa-tag" style="font-size:0.65rem;"></i> <%= t.category || 'Lainnya' %> 
                                                &nbsp;•&nbsp; 
                                                <i class="fas fa-calendar" style="font-size:0.65rem;"></i> <%= new Date(t.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="trans-right">
                                        <div class="trans-amount <%= t.type === 'income' ? 'positive' : 'negative' %>">
                                            <%= t.type === 'income' ? '+' : '-' %> Rp <%= parseInt(t.amount).toLocaleString('id-ID') %>
                                        </div>
                                        <form action="/transactions/delete/<%= t.id %>" method="POST" style="margin:0;" onsubmit="return confirm('Hapus transaksi ini?')">
                                            <button type="submit" class="btn-delete" title="Hapus">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-inbox"></i>
                            <h3>Belum ada transaksi</h3>
                            <p>Mulai dengan menambahkan transaksi pertamamu di form sebelah kiri</p>
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </main>

    <script>
        // === Type Toggle + Category Filter ===
        function setType(type) {
            document.getElementById('typeInput').value = type;
            const btnExpense = document.getElementById('btnExpense');
            const btnIncome = document.getElementById('btnIncome');
            const submitBtn = document.getElementById('submitBtn');

            if (type === 'income') {
                btnIncome.className = 'type-btn active-income';
                btnExpense.className = 'type-btn';
                submitBtn.className = 'btn-submit income-mode';
            } else {
                btnExpense.className = 'type-btn active-expense';
                btnIncome.className = 'type-btn';
                submitBtn.className = 'btn-submit';
            }

            // Filter categories by type
            var select = document.getElementById('categorySelect');
            var options = select.querySelectorAll('option');
            var firstVisible = null;
            options.forEach(function(opt) {
                var optType = opt.getAttribute('data-type');
                if (!optType || optType === type) {
                    opt.style.display = '';
                    if (!firstVisible) firstVisible = opt;
                } else {
                    opt.style.display = 'none';
                }
            });
            if (firstVisible) select.value = firstVisible.value;
        }

        // Filter on page load
        setType('expense');

        // === Format Rupiah (auto titik) ===
        function formatRupiah(el) {
            // Ambil hanya angka
            let value = el.value.replace(/\D/g, '');
            // Simpan angka asli ke hidden input
            document.getElementById('amountRaw').value = value;
            // Format dengan titik ribuan
            if (value) {
                el.value = parseInt(value).toLocaleString('id-ID');
            } else {
                el.value = '';
            }
        }

        // Validasi sebelum submit — pastikan amount terisi
        document.getElementById('transForm').addEventListener('submit', function(e) {
            const raw = document.getElementById('amountRaw').value;
            if (!raw || parseInt(raw) <= 0) {
                e.preventDefault();
                alert('Masukkan jumlah yang valid!');
            }
        });

        // === Search/Filter ===
        function filterTransactions() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const items = document.querySelectorAll('.trans-item');
            items.forEach(function(item) {
                const desc = item.getAttribute('data-desc') || '';
                const cat = item.getAttribute('data-cat') || '';
                if (desc.includes(query) || cat.includes(query)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>