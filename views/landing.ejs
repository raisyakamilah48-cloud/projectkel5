<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CekUangku - Kelola Keuangan Cerdas</title>
    <!-- Font Poppins & Righteous -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Righteous&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            /* Light Theme Variables */
            --bg-light: #f8f9fa;
            --bg-white: #ffffff;
            --primary-blue: #4361ee;
            --secondary-blue: #3f37c9;
            --light-blue: #e0e7ff;
            --text-dark: #1f2937;
            --text-muted: #6b7280;
            --text-light: #ffffff;
            --shape-bg: #4cc9f0;
            --nav-border: rgba(0,0,0,0.05);
            --card-border: rgba(0,0,0,0.05);
        }

        body.dark-mode {
            /* Dark Theme Variables */
            --bg-light: #0d1117;
            --bg-white: #161b22;
            --primary-blue: #58a6ff;
            --secondary-blue: #79c0ff;
            --light-blue: #1f2937; /* Darker backing */
            --text-dark: #f0f6fc;
            --text-muted: #8b949e;
            --text-light: #ffffff;
            --shape-bg: #1f6feb;
            --nav-border: rgba(255,255,255,0.05);
            --card-border: rgba(255,255,255,0.05);
        }

        /* Essential color transition for smooth theme switching */
        body, .landing-nav, .site-footer, .title-box, .feature-card, .value-card, .bg-shape {
            transition: background-color 0.5s ease, color 0.5s ease, border-color 0.5s ease;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { 
            font-family: 'Poppins', sans-serif; 
            background-color: var(--bg-light); 
            color: var(--text-dark);
            overflow-x: hidden;
        }
        a { text-decoration: none; }

        /* --- NAVBAR --- */
        .navbar-wrapper {
            position: fixed; top: 20px; left: 0; width: 100%;
            z-index: 1000; display: flex; justify-content: center;
            padding: 0 20px; transition: all 0.3s ease;
        }
        .landing-nav {
            background-color: var(--bg-white);
            width: 100%; max-width: 1200px; border-radius: 50px;
            display: flex; justify-content: space-between; align-items: center;
            padding: 15px 40px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border: 1px solid var(--nav-border);
        }
        .nav-left { display: flex; align-items: center; gap: 40px; }
        .menu-icon { color: var(--primary-blue); font-size: 1.2rem; cursor: pointer; display: none; }
        .nav-links { display: flex; gap: 30px; }
        .nav-links a {
            color: var(--text-dark); font-weight: 600; font-size: 0.95rem;
            text-transform: uppercase; letter-spacing: 1px; transition: color 0.3s;
        }
        .nav-links a.active, .nav-links a:hover { color: var(--primary-blue); }
        
        .nav-right { display: flex; align-items: center; gap: 20px; }
        .logo { 
            font-size: 1.3rem; font-weight: 800; color: var(--primary-blue); 
            display: flex; align-items: center; gap: 10px; letter-spacing: 1px;
        }

        /* Theme Toggle Button */
        .theme-toggle {
            background: transparent; border: none; outline: none;
            color: var(--text-dark); font-size: 1.2rem; cursor: pointer;
            width: 35px; height: 35px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            transition: transform 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55), color 0.3s, background-color 0.3s;
        }
        .theme-toggle:hover { background: var(--light-blue); color: var(--primary-blue); transform: scale(1.1) rotate(15deg); }
        .theme-toggle.rotated { transform: rotate(360deg); } /* Animation class */

        /* --- HERO SECTION --- */
        .hero {
            position: relative; min-height: 100vh; display: flex;
            align-items: center; justify-content: center; overflow: hidden;
            padding: 120px 20px 40px; background-color: var(--bg-light);
        }

        .bg-shape { position: absolute; z-index: 0; will-change: transform; transition: opacity 0.5s; }
        .shape-center {
            top: 20%; left: -20%; width: 140%; height: 60%;
            background: linear-gradient(135deg, rgba(67, 97, 238, 0.05) 0%, rgba(67, 97, 238, 0.15) 100%);
            clip-path: polygon(0 40%, 100% 0, 100% 60%, 0 100%);
        }
        
        /* Specific opacity adjustments for bright shapes in dark mode */
        body.dark-mode .shape-center {
            background: linear-gradient(135deg, rgba(88, 166, 255, 0.05) 0%, rgba(88, 166, 255, 0.1) 100%);
        }

        .shape-accent { background-color: var(--primary-blue); opacity: 0.8; will-change: transform; }
        .s-1 { top: -20%; left: 10%; width: 300px; height: 800px; transform: rotate(30deg); opacity: 0.05; background: var(--secondary-blue); position: absolute;}
        body.dark-mode .s-1 { opacity: 0.02; }
        
        .s-2 { bottom: -10%; right: -5%; width: 15%; height: 120%; clip-path: polygon(50% 0, 100% 0, 100% 100%, 0% 100%); background: var(--light-blue); position: absolute; z-index: 0;}
        body.dark-mode .s-2 { background: rgba(88, 166, 255, 0.05); }

        .dots-pattern {
            position: absolute; width: 300px; height: 300px;
            background-image: radial-gradient(var(--primary-blue) 2px, transparent 2px);
            background-size: 20px 20px; opacity: 0.1; z-index: 0; will-change: transform;
            transition: opacity 0.5s;
        }
        body.dark-mode .dots-pattern { opacity: 0.05; }
        .dots-1 { top: 15%; right: 15%; }
        .dots-2 { bottom: 15%; left: 10%; }

        .floating-elem { position: absolute; z-index: 1; will-change: transform; }
        .box-solid-blue { background: var(--primary-blue); width: 20px; height: 20px; }
        .box-hollow-blue { border: 3px solid var(--primary-blue); width: 25px; height: 25px; }
        .box-light-blue { background: var(--light-blue); width: 20px; height: 20px; }

        .f-1 { top: 25%; left: 25%; }
        .f-2 { top: 15%; right: 25%; border: 3px solid var(--primary-blue); width: 20px; height: 20px; }
        .f-3 { bottom: 30%; left: 15%; display: flex; flex-direction: column; gap: 5px; }
        .f-4 { bottom: 35%; right: 20%; display: flex; }

        .hero-avatar {
            position: absolute;
            bottom: 0;
            right: 0%;
            height: 50vh;
            max-height: 450px;
            z-index: 5;
            object-fit: contain;
            filter: drop-shadow(-10px 10px 20px rgba(0,0,0,0.1));
            will-change: transform;
        }

        .hero-content {
            position: relative; z-index: 10; text-align: center;
            max-width: 800px; color: var(--text-dark);
            display: flex; flex-direction: column; align-items: center;
            animation: fadeIn 1.5s ease-out; will-change: transform;
        }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

        .title-box {
            border: 4px solid var(--primary-blue); padding: 40px 60px;
            margin-bottom: 25px; position: relative; display: inline-block;
            will-change: transform;
            background: transparent;
        }

        .title-box h1 {
            font-family: 'Righteous', 'Poppins', sans-serif;
            font-size: 5rem; line-height: 1.1; text-transform: uppercase;
            letter-spacing: 2px; margin: 0; color: var(--primary-blue);
        }
        .title-box h1 span { color: var(--secondary-blue); }

        .hero-desc {
            font-size: 1.15rem; font-weight: 500; max-width: 600px;
            margin: 0 auto 40px; line-height: 1.6; color: var(--text-muted);
            will-change: transform;
        }

        .hero-cta { will-change: transform; }

        .read-more-btn {
            background-color: var(--primary-blue); color: var(--text-light);
            padding: 15px 40px; border-radius: 30px; font-weight: 700;
            font-size: 1rem; text-transform: uppercase; letter-spacing: 1px;
            display: inline-block; border: 2px solid var(--primary-blue);
            box-shadow: 0 10px 25px rgba(67,97,238,0.3);
            transition: all 0.3s;
        }
        body.dark-mode .read-more-btn { color: #0d1117; } /* Dark text on bright blue button in dark mode */
        body.dark-mode .read-more-btn.outline { color: var(--primary-blue); }
        
        .read-more-btn:hover {
            background-color: transparent; border-color: var(--primary-blue);
            color: var(--primary-blue); transform: translateY(-3px);
            box-shadow: none;
        }
        .read-more-btn.outline {
            background-color: transparent; border-color: var(--primary-blue);
            color: var(--primary-blue); margin-left: 15px; box-shadow: none;
        }
        .read-more-btn.outline:hover {
            background-color: var(--primary-blue); color: var(--text-light);
        }
        body.dark-mode .read-more-btn.outline:hover { color: #0d1117;}

        .hero-dots { margin-top: 30px; display: flex; justify-content: center; gap: 10px; will-change: transform; }
        .hero-dots span { width: 10px; height: 10px; background-color: var(--primary-blue); border-radius: 50%; opacity: 0.3; }
        .hero-dots span.active { background-color: var(--secondary-blue); opacity: 1; }

        .social-icons { margin-top: 60px; display: flex; gap: 20px; will-change: transform; }
        .social-icons a {
            width: 45px; height: 45px; background-color: var(--bg-white);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            color: var(--primary-blue); font-size: 1.2rem; transition: all 0.3s;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08); border: 1px solid var(--nav-border);
        }
        .social-icons a:hover {
            background-color: var(--primary-blue); color: var(--bg-white); transform: translateY(-5px);
        }

        /* --- FEATURES SECTION --- */
        .features { 
            padding: 100px 20px; background: var(--bg-white); 
            text-align: center; position: relative; z-index: 2;
        }
        .features h2 { 
            font-size: 2.8rem; margin-bottom: 60px; color: var(--text-dark); 
            font-family: 'Righteous', 'Poppins', sans-serif; text-transform: uppercase;
        }
        .features h2 span { color: var(--primary-blue); }

        .feature-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px; max-width: 1200px; margin: 0 auto;
        }
        .feature-card {
            background: var(--bg-light); padding: 40px 30px; border-radius: 15px;
            border: 1px solid var(--card-border); text-align: center;
            position: relative; overflow: hidden;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color 0.5s ease, box-shadow 0.4s ease;
        }
        .feature-card::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 5px;
            background: var(--primary-blue); transform: scaleX(0);
            transform-origin: left; transition: transform 0.4s ease;
        }
        .feature-card:hover { 
            transform: translateY(-10px); background: var(--bg-white);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08); border-color: transparent;
        }
        body.dark-mode .feature-card:hover { box-shadow: 0 15px 30px rgba(0,0,0,0.3); }

        .feature-card:hover::before { transform: scaleX(1); }
        .icon-box {
            width: 80px; height: 80px; background: var(--light-blue); 
            color: var(--primary-blue); border-radius: 50%; display: flex; 
            align-items: center; justify-content: center; font-size: 2rem; 
            margin: 0 auto 25px;
        }
        /* In dark mode, lighten the icon backing just a bit */
        body.dark-mode .icon-box { background: rgba(88, 166, 255, 0.1); }

        .feature-card h3 { margin-bottom: 15px; color: var(--text-dark); font-size: 1.4rem; font-weight: 600;}
        .feature-card p { color: var(--text-muted); line-height: 1.7; font-size: 0.95rem; }

        /* --- FOOTER STYLE --- */
        .site-footer {
            background-color: var(--bg-light); color: var(--text-dark);
            padding: 80px 20px 20px; position: relative; z-index: 2;
            border-top: 1px solid var(--nav-border);
        }
        .footer-container {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 50px; max-width: 1200px; margin: 0 auto;
        }
        .footer-col h3 {
            font-size: 1.3rem; margin-bottom: 25px; color: var(--text-dark);
            font-weight: 600; position: relative; padding-bottom: 10px;
        }
        .footer-col h3::after {
            content: ''; position: absolute; left: 0; bottom: 0;
            width: 40px; height: 3px; background-color: var(--primary-blue);
        }
        .footer-col p { color: var(--text-muted); line-height: 1.7; font-size: 0.95rem; }
        .footer-col ul { list-style: none; padding: 0; }
        .footer-col ul li { margin-bottom: 12px; }
        .footer-col ul li a {
            color: var(--text-muted); text-decoration: none;
            transition: all 0.3s; font-size: 0.95rem; display: inline-block;
        }
        .footer-col ul li a:hover { color: var(--primary-blue); transform: translateX(5px); }
        .footer-bottom {
            text-align: center; margin-top: 60px; padding-top: 25px;
            border-top: 1px solid var(--nav-border); color: var(--text-muted); font-size: 0.85rem;
        }

        /* --- RESPONSIVE --- */
        @media (max-width: 1200px) {
            .hero-avatar { height: 40vh; right: -5%; opacity: 0.5; z-index: 0; }
        }
        @media (max-width: 992px) {
            .title-box h1 { font-size: 4rem; }
            .hero-avatar { display: none; }
        }
        @media (max-width: 768px) {
            .landing-nav { border-radius: 10px; padding: 15px 20px; }
            .menu-icon { display: block; }
            .nav-links {
                display: none; position: absolute; top: 70px; left: 20px; right: 20px;
                background: var(--bg-white); flex-direction: column; align-items: center;
                padding: 20px 0; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            }
            .nav-links.active { display: flex; }
            .title-box { padding: 30px 20px; }
            .title-box h1 { font-size: 3rem; }
            
            .hero-content { margin-top: 50px; }
            .features h2 { font-size: 2rem; }
        }
    </style>
</head>
<body>

    <!-- NAVBAR FIXED -->
    <div class="navbar-wrapper">
        <nav class="landing-nav">
            <div class="nav-left">
                <i class="fas fa-bars menu-icon" onclick="document.querySelector('.nav-links').classList.toggle('active')"></i>
                <div class="nav-links">
                    <a href="#home" class="active">HOME</a>
                    <a href="#features">FEATURES</a>
                    <a href="/about">ABOUT</a>
                    <a href="/auth/login">CONTACT</a>
                </div>
            </div>
            
            <div class="nav-right">
                <!-- Theme Toggle Button -->
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle Dark Mode">
                    <i class="fas fa-moon"></i>
                </button>
                <a href="/" class="logo">
                    <img src="/images/asset-avatar/Main.png" alt="Logo" style="height: 35px; width: auto; margin-right: 8px;"> CEKUANGKU
                </a>
            </div>
        </nav>
    </div>

    <main>
        <!-- HERO SECTION -->
        <section class="hero" id="home">
            <div class="bg-shape shape-center parallax" data-speed="0.1"></div>
            <div class="s-1 parallax" data-speed="-0.1"></div>
            <div class="s-2 parallax" data-speed="0.3"></div>
            <div class="dots-pattern dots-1 parallax" data-speed="0.4"></div>
            <div class="dots-pattern dots-2 parallax" data-speed="-0.3"></div>

            <img src="/images/asset-avatar/Thingking.png" alt="Hero Avatar" class="hero-avatar parallax" data-speed="0.15">

            <div class="floating-elem box-hollow-blue f-1 parallax" data-speed="0.8"></div>
            <div class="floating-elem f-2 parallax" data-speed="-0.5"></div>
            
            <div class="floating-elem f-3 parallax" data-speed="0.5">
                <div class="box-solid-blue"></div>
                <div class="box-light-blue"></div>
            </div>
            <div class="floating-elem f-4 parallax" data-speed="-0.7">
                <div class="box-hollow-blue"></div>
                <div class="box-solid-blue" style="margin-top: 15px; margin-left: -10px;"></div>
            </div>

            <!-- Hero Content -->
            <div class="hero-content">
                <div class="title-box parallax" data-speed="0.1">
                    <h1>KELOLA UANG<br><span>CERDAS</span></h1>
                </div>
                
                <p class="hero-desc parallax" data-speed="0.15">
                    Catat pemasukan dan pengeluaran, lihat grafik keuangan bulanan, dan capai target tabungan Anda dengan platform sederhana yang dirancang untuk kesuksesan finansial.
                </p>

                <div class="hero-cta parallax" data-speed="0.2">
                    <% if (user) { %>
                        <a href="/dashboard" class="read-more-btn">Buka Dashboard</a>
                    <% } else { %>
                        <a href="/auth/register" class="read-more-btn">Buka Dashboard</a>
                    <% } %>
                </div>

                <div class="hero-dots parallax" data-speed="0.25">
                    <span class="active"></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <div class="social-icons parallax" data-speed="0.3">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>
            </div>
        </section>

        <!-- FEATURES SECTION -->
        <section id="features" class="features">
            <h2>Mengapa <span>CekUangku?</span></h2>
            <div class="feature-grid">
                <div class="feature-card">
                    <div class="icon-box"><i class="fas fa-chart-line"></i></div>
                    <h3>Laporan Real-time</h3>
                    <p>Pantau perkembangan keuangan Anda dengan grafik cerdas yang mudah dipahami dan diupdate secara instan setiap transaksi.</p>
                </div>
                <div class="feature-card">
                    <div class="icon-box"><i class="fas fa-shield-alt"></i></div>
                    <h3>Keamanan Terjamin</h3>
                    <p>Privasi adalah prioritas kami. Data keuangan Anda dienkripsi tingkat tinggi dan tersimpan aman di infrastruktur cloud kami.</p>
                </div>
                <div class="feature-card">
                    <div class="icon-box"><i class="fas fa-mobile-alt"></i></div>
                    <h3>Akses Kapan Saja</h3>
                    <p>Desain ultra-responsif memungkinkan Anda mengelola anggaran dari laptop, tablet, maupun smartphone tanpa hambatan.</p>
                </div>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-col">
                <div class="logo" style="margin-bottom: 20px;">
                    <img src="/images/asset-avatar/Main.png" alt="Logo" style="height: 35px; width: auto; margin-right: 8px;"> CEKUANGKU
                </div>
                <p>Platform manajemen keuangan pribadi modern untuk membantu Anda mengelola pengeluaran dan mencapai kebebasan finansial.</p>
            </div>
            <div class="footer-col">
                <h3>Navigasi</h3>
                <ul>
                    <li><a href="/">Beranda</a></li>
                    <li><a href="#features">Fitur Kami</a></li>
                    <li><a href="/about">Tentang Kami</a></li>
                    <li><a href="/auth/login">Masuk / Daftar</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>Kontak & Dukungan</h3>
                <ul>
                    <li><a href="#">Pusat Bantuan</a></li>
                    <li><a href="#">Kebijakan Privasi</a></li>
                    <li><a href="#">Syarat Ketentuan</a></li>
                    <li><a href="#">Hubungi Developer</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2024 CekUangku Kelompok 5. All rights reserved.</p>
        </div>
    </footer>

    <!-- Scripts: Parallax, Scrollspy, and Theme Toggle -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Theme Toggle Logic
            const themeToggle = document.getElementById('themeToggle');
            const icon = themeToggle.querySelector('i');
            
            // Check LocalStorage
            const storedTheme = localStorage.getItem('theme');
            if (storedTheme === 'dark') {
                document.body.classList.add('dark-mode');
                icon.classList.replace('fa-moon', 'fa-sun');
            }
            
            themeToggle.addEventListener('click', () => {
                // Animation rotation
                themeToggle.classList.add('rotated');
                setTimeout(() => { themeToggle.classList.remove('rotated'); }, 500);

                // Toggle logic
                document.body.classList.toggle('dark-mode');
                if (document.body.classList.contains('dark-mode')) {
                    icon.classList.replace('fa-moon', 'fa-sun');
                    localStorage.setItem('theme', 'dark');
                } else {
                    icon.classList.replace('fa-sun', 'fa-moon');
                    localStorage.setItem('theme', 'light');
                }
            });

            // Parallax and Scrollspy Logic
            const parallaxElements = document.querySelectorAll('.parallax');
            const sections = document.querySelectorAll('section');
            const navLinks = document.querySelectorAll('.nav-links a');
            
            window.addEventListener('scroll', () => {
                let scrollY = window.pageYOffset;
                
                parallaxElements.forEach(el => {
                    let speed = el.getAttribute('data-speed');
                    el.style.transform = `translateY(${scrollY * speed}px)`;
                });

                sections.forEach(sec => {
                    let top = window.scrollY;
                    let offset = sec.offsetTop - 200; 
                    let height = sec.offsetHeight;
                    let id = sec.getAttribute('id');

                    if(top >= offset && top < offset + height && id) {
                        navLinks.forEach(links => { links.classList.remove('active'); });
                        let activeLink = document.querySelector(`.nav-links a[href="#${id}"]`);
                        if(activeLink) activeLink.classList.add('active');
                    }
                });
            });
        });
    </script>
</body>
</html>