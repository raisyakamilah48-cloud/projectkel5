<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - CekUangku</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-blue: #4361ee;
            --secondary-blue: #3f37c9;
            --light-blue: #4cc9f0;
        }
        body, html { margin: 0; padding: 0; font-family: 'Poppins', sans-serif; height: 100%; }
        .split-screen { display: flex; width: 100%; height: 100vh; }
        .left-pane {
            flex: 1; background: linear-gradient(135deg, var(--light-blue) 0%, var(--primary-blue) 100%);
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            color: white; padding: 40px; text-align: center; position: relative; overflow: hidden;
        }
        .left-pane-content { z-index: 2; max-width: 80%; }
        .brand-logo {
            display: flex; align-items: center; justify-content: center; gap: 10px;
            font-size: 2rem; font-weight: 700; margin-bottom: 40px; color: white; text-decoration: none; cursor: pointer;
        }
        .illustration-box {
            width: 100%; max-width: 350px; height: 250px; background: rgba(255,255,255,0.15);
            backdrop-filter: blur(10px); border-radius: 20px; margin: 0 auto 30px;
            display: flex; align-items: center; justify-content: center;
            border: 1px solid rgba(255,255,255,0.2);
        }
        .illustration-box svg { width: 100px; height: 100px; stroke: white; stroke-width: 1.5; }
        .left-pane h2 { font-size: 2.5rem; margin-bottom: 15px; }
        .left-pane p { font-size: 1.1rem; opacity: 0.9; }
        .right-pane {
            flex: 1; background: white; display: flex; flex-direction: column;
            justify-content: center; align-items: center; padding: 40px;
        }
        .form-container { width: 100%; max-width: 400px; }
        .welcome-text h2 { font-size: 2rem; color: #333; margin-bottom: 5px; }
        .welcome-text p { color: #666; margin-bottom: 30px; }
        .form-group { margin-bottom: 20px; text-align: left; }
        .form-group label { display: block; margin-bottom: 8px; color: #555; font-size: 0.9rem; }
        .form-control {
            width: 100%; padding: 12px 15px; border: 1px solid #ddd;
            border-radius: 8px; font-size: 1rem;
        }
        .btn-primary {
            width: 100%; padding: 14px; border-radius: 8px; border: none;
            background: linear-gradient(to right, var(--primary-blue), var(--secondary-blue));
            color: white; font-weight: 600; font-size: 1rem; cursor: pointer; transition: 0.3s;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(67, 97, 238, 0.3); }
        .btn-link {
            background: none; border: none; color: var(--primary-blue);
            text-decoration: none; font-weight: 500; margin-top: 15px; cursor: pointer;
            width: 100%; text-align: center;
        }
        .btn-link:hover { text-decoration: underline; }
        .alert-box {
            background-color: #fff5f5; color: #e74c3c; padding: 12px 15px;
            border-radius: 8px; margin-bottom: 20px; font-size: 0.85rem;
            border: 1px solid #fed7d7; display: flex; gap: 10px; line-height: 1.4;
        }
        @media (max-width: 768px) {
            .split-screen { flex-direction: column; }
            .left-pane { flex: 0 0 30%; padding: 20px; }
            .left-pane h2 { font-size: 1.5rem; }
            .right-pane { flex: 1; border-top-left-radius: 30px; border-top-right-radius: 30px; margin-top: -20px; z-index: 10; box-shadow: 0 -5px 20px rgba(0,0,0,0.05); }
        }
    </style>
</head>
<body>

    <div class="split-screen">
        <div class="left-pane">
            <div class="left-pane-content">
                <a href="/" class="brand-logo">
                    <i class="fas fa-wallet"></i> CekUangku
                </a>

                <div class="illustration-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/>
                        <path d="M4 6v12a2 2 0 0 0 2 2h14v-4"/>
                        <path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z"/>
                    </svg>
                </div>
                <h2>Welcome Back : )</h2>
                <p>Kelola keuangan Anda bersama CekUangku.</p>
            </div>
        </div>

        <div class="right-pane">
            <div class="form-container">
                <div class="welcome-text">
                    <h2>Login</h2>
                    <p>Silakan masuk ke akun Anda</p>
                </div>

                <% if (message) { %>
                    <div class="alert-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <div><%= message %></div>
                    </div>
                <% } %>

                <form action="/auth/login" method="POST">
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" name="email" class="form-control" placeholder="name@gmail.com" required>
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" name="password" class="form-control" placeholder="•••••••••" required>
                    </div>
                    <button type="submit" class="btn-primary">Login</button>
                </form>

                <button onclick="window.location.href='/auth/register'" class="btn-link">
                    Belum punya akun? Join Now
                </button>
            </div>
        </div>
    </div>
</body>
</html>