<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Login - CekUangku</title>
    <link rel="icon" type="image/png" href="/images/asset-avatar/Main.png">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="prefetch" href="/auth/register">
    <style>
        :root {
            --ink: #0f172a;
            --muted: #64748b;
            --brand: #0ea5e9;
            --brand-deep: #0369a1;
            --accent: #22c55e;
            --bg: #f7f9fc;
            --card: #ffffff;
            --ring: rgba(14, 165, 233, 0.2);
            --shadow: 0 20px 60px rgba(15, 23, 42, 0.12);
            --input-bg: #f8fafc;
            --border-color: rgba(148, 163, 184, 0.5);
        }

        body.dark-mode {
            --ink: #f0f6fc;
            --muted: #8b949e;
            --bg: #0d1117;
            --card: #161b22;
            --ring: rgba(14, 165, 233, 0.4);
            --shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            --input-bg: #0d1117;
            --border-color: rgba(148, 163, 184, 0.2);
            --brand-deep: #38bdf8;
        }

        .theme-toggle {
            position: absolute; top: 24px; right: 24px;
            background: transparent; border: 1px solid var(--muted); color: var(--muted);
            width: 32px; height: 32px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            opacity: 0.5; transition: all 0.3s ease; z-index: 100; cursor: pointer; font-size: 1rem;
        }
        .theme-toggle:hover { opacity: 1; color: var(--ink); border-color: var(--ink); }
        .theme-toggle.rotated { transform: rotate(360deg); }
        
        body, .form-area, .form-card, .form-control, .btn-secondary, .alert-box { transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease; }

        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Manrope', sans-serif;
            background: var(--bg);
            color: var(--ink);
        }

        body {
            animation: pageIn 420ms ease;
        }

        .transition-overlay {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, #0ea5e9 0%, #1e40af 55%, #0f172a 100%);
            transform: translateY(-100%);
            z-index: 9999;
            pointer-events: none;
        }

        .transition-overlay::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -1px;
            height: 70px;
            background: #f7f9fc;
            clip-path: path("M0,35 C120,65 240,5 360,35 C480,65 600,5 720,35 C840,65 960,5 1080,35 C1200,65 1320,5 1440,35 C1560,65 1680,5 1800,35 L1800,70 L0,70 Z");
        }

        @media (max-width: 640px) {
            .transition-overlay::after {
                height: 56px;
                clip-path: path("M0,28 C90,52 180,4 270,28 C360,52 450,4 540,28 C630,52 720,4 810,28 C900,52 990,4 1080,28 L1080,56 L0,56 Z");
            }
        }

        body.is-entering .transition-overlay {
            animation: curtainDown 900ms ease forwards;
        }

        body.is-leaving .transition-overlay {
            animation: curtainUp 520ms ease forwards;
        }

        @keyframes pageIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes curtainUp {
            0% { transform: translateY(-100%); }
            60% { transform: translateY(0%); }
            100% { transform: translateY(0%); }
        }

        @keyframes curtainDown {
            0% { transform: translateY(0%); }
            100% { transform: translateY(-100%); }
        }

        .page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            gap: 0;
        }

        .visual {
            position: relative;
            padding: 48px;
            color: #e0f2fe;
            background:
                radial-gradient(1200px 600px at -10% -30%, rgba(255,255,255,0.22), transparent 60%),
                radial-gradient(800px 400px at 120% 0%, rgba(255,255,255,0.18), transparent 55%),
                linear-gradient(135deg, #0ea5e9 0%, #1e40af 55%, #0f172a 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }

        .visual-pattern {
            position: absolute;
            inset: 0;
            background:
                repeating-linear-gradient(120deg, rgba(255,255,255,0.10) 0 1px, transparent 1px 16px),
                repeating-linear-gradient(30deg, rgba(255,255,255,0.06) 0 1px, transparent 1px 22px);
            opacity: 0.55;
            background-size: 220% 220%;
            background-position: 0% 0%;
            transition: opacity 0.35s ease;
            animation: shimmer 16s linear infinite;
            animation-play-state: paused;
            pointer-events: none;
        }

        .visual:hover .visual-pattern {
            opacity: 0.9;
            animation-play-state: running;
        }

        @keyframes shimmer {
            0% { background-position: 0% 0%; }
            50% { background-position: 80% 20%; }
            100% { background-position: 0% 0%; }
        }

        .visual::before,
        .visual::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            filter: blur(0);
            opacity: 0.7;
            pointer-events: none;
        }

        .visual::before {
            width: 220px;
            height: 220px;
            left: 12%;
            top: 8%;
            border: 1px dashed rgba(255,255,255,0.25);
        }

        .visual::after {
            width: 320px;
            height: 320px;
            right: -40px;
            bottom: -60px;
            border: 1px solid rgba(255,255,255,0.18);
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.08), transparent 60%);
        }

        .visual-hero {
            position: absolute;
            left: clamp(140px, 16vw, 210px);
            top: clamp(90px, 12vh, 170px);
            width: clamp(200px, 26vw, 300px);
            height: clamp(170px, 20vw, 240px);
            display: flex;
            align-items: center;
            justify-content: center;
            transform: translateZ(0);
        }

        .visual-hero img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center;
            filter: drop-shadow(0 18px 40px rgba(2, 6, 23, 0.35));
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.6rem;
            letter-spacing: -0.02em;
            color: #ffffff;
            text-decoration: none;
        }

        .brand img {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            object-fit: cover;
            box-shadow: 0 12px 24px rgba(15, 23, 42, 0.35);
            border: 2px solid rgba(255,255,255,0.5);
        }

        .visual-card {
            margin-top: 48px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 28px;
            padding: 32px;
            backdrop-filter: blur(12px);
            box-shadow: 0 20px 50px rgba(2, 6, 23, 0.35);
        }

        .visual-card h1 {
            margin: 0 0 12px;
            font-size: 2.4rem;
            line-height: 1.1;
        }

        .visual-card p {
            margin: 0;
            color: rgba(255,255,255,0.85);
            font-size: 1rem;
        }

        .visual-footer {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-top: 36px;
        }

        .pill {
            padding: 10px 16px;
            border-radius: 999px;
            background: rgba(255,255,255,0.14);
            color: #e0f2fe;
            font-size: 0.85rem;
            border: 1px solid rgba(255,255,255,0.18);
        }

        .form-area {
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 24px;
        }

        .form-card {
            width: 100%;
            max-width: 420px;
            background: var(--card);
            border-radius: 28px;
            padding: 36px;
            box-shadow: var(--shadow);
            border: 1px solid rgba(148, 163, 184, 0.2);
        }

        .form-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 24px;
        }

        .form-title h2 {
            margin: 0 0 6px;
            font-size: 1.8rem;
        }

        .form-title p {
            margin: 0;
            color: var(--muted);
            font-size: 0.95rem;
        }

        .alert-box {
            background: #fff1f2;
            color: #be123c;
            padding: 12px 14px;
            border-radius: 12px;
            margin-bottom: 18px;
            font-size: 0.9rem;
            border: 1px solid #fecdd3;
            display: flex;
            gap: 10px;
            line-height: 1.4;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 8px;
            color: var(--ink);
        }

        .input-wrap {
            position: relative;
        }

        .form-control {
            width: 100%;
            padding: 12px 44px 12px 44px;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            font-size: 0.98rem;
            transition: 0.2s ease;
            background: var(--input-bg);
            color: var(--ink);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--brand);
            box-shadow: 0 0 0 4px var(--ring);
            background: var(--card);
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.95rem;
            color: var(--muted);
        }

        .toggle-visibility {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            cursor: pointer;
            color: var(--muted);
            font-size: 1rem;
            padding: 6px;
            border-radius: 8px;
        }

        .toggle-visibility:hover {
            color: var(--brand-deep);
            background: rgba(14, 165, 233, 0.08);
        }

        .toggle-visibility.animate {
            animation: eyePop 260ms ease;
        }

        @keyframes eyePop {
            0% { transform: translateY(-50%) scale(1); }
            50% { transform: translateY(-50%) scale(1.2) rotate(-8deg); }
            100% { transform: translateY(-50%) scale(1); }
        }

        .row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            color: var(--muted);
        }

        .row a {
            color: var(--brand-deep);
            text-decoration: none;
            font-weight: 600;
        }

        .btn-primary {
            width: 100%;
            padding: 14px 16px;
            border-radius: 14px;
            border: none;
            background: linear-gradient(135deg, var(--brand), var(--brand-deep));
            color: white;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 30px rgba(14, 165, 233, 0.25);
        }

        .btn-secondary {
            width: 100%;
            margin-top: 14px;
            padding: 12px 16px;
            border-radius: 14px;
            border: 1px solid var(--border-color);
            background: var(--card);
            color: var(--ink);
            font-weight: 600;
            cursor: pointer;
        }

        .btn-secondary:hover {
            border-color: var(--brand);
            color: var(--brand-deep);
        }

        .helper {
            margin-top: 18px;
            font-size: 0.9rem;
            color: var(--muted);
            text-align: center;
        }

        .helper a {
            color: var(--brand-deep);
            font-weight: 700;
            text-decoration: none;
        }

        .loading-modal {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            display: grid;
            place-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
            z-index: 10000;
        }

        .loading-modal.show {
            opacity: 1;
            pointer-events: all;
        }

        .loading-card {
            width: min(420px, 90vw);
            background: #0f172a;
            border-radius: 24px;
            padding: 28px;
            color: #e2e8f0;
            box-shadow: 0 24px 70px rgba(15, 23, 42, 0.45);
            text-align: center;
        }

        .loading-video {
            width: min(240px, 70vw);
            height: auto;
            border-radius: 18px;
            display: block;
            margin: 0 auto 18px;
            background: #0b1220;
        }

        .loading-title {
            font-weight: 700;
            margin-bottom: 10px;
        }

        .progress-track {
            height: 8px;
            background: rgba(255,255,255,0.12);
            border-radius: 999px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            width: 35%;
            background: linear-gradient(90deg, #38bdf8, #60a5fa);
            border-radius: inherit;
            animation: progressMove 1.2s ease-in-out infinite;
        }

        @keyframes progressMove {
            0% { transform: translateX(-80%); }
            50% { transform: translateX(40%); }
            100% { transform: translateX(180%); }
        }

        @media (max-width: 980px) {
            .page {
                grid-template-columns: 1fr;
            }
            .visual {
                min-height: 360px;
            }
            .visual-hero {
                position: static;
                width: 220px;
                height: 190px;
                margin: 24px auto 0;
            }
            .visual-card {
                margin-top: 24px;
            }
        }

        @media (max-width: 540px) {
            .page {
                background: linear-gradient(180deg, #1d4ed8 0%, #4f46e5 45%, #f7f9fc 45%);
            }
            .visual {
                padding: 36px 24px 0;
                min-height: 300px;
                align-items: center;
                text-align: center;
            }
            .brand {
                font-size: 1.4rem;
            }
            .brand img {
                width: 42px;
                height: 42px;
            }
            .visual-card {
                display: none;
            }
            .visual-hero {
                width: 150px;
                height: 140px;
                margin: -18px auto 0;
            }
            .form-area {
                padding: 0 18px 28px;
                background: transparent;
                position: relative;
            }
            .form-card {
                margin-top: -36px;
                padding: 26px 20px 28px;
                border-radius: 28px;
                border-top-left-radius: 32px;
                border-top-right-radius: 32px;
                overflow: hidden;
                box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
            }
            .form-area::before {
                content: "";
                position: absolute;
                left: 18px;
                right: 18px;
                top: -18px;
                height: 36px;
                background: #ffffff;
                border-top-left-radius: 24px;
                border-top-right-radius: 24px;
                box-shadow: 0 -6px 16px rgba(15, 23, 42, 0.08);
            }
            .form-title h2 {
                font-size: 1.5rem;
            }
            .btn-primary {
                border-radius: 16px;
            }
        }
    </style>
</head>
<body style="background: var(--bg);">
    <button class="theme-toggle" id="themeToggle" aria-label="Toggle Dark Mode">
        <i class="fas fa-moon"></i>
    </button>
    <div class="transition-overlay" aria-hidden="true"></div>

    <div class="page">
        <section class="visual">
            <div class="visual-pattern" aria-hidden="true"></div>
            <a href="/" class="brand">
                <img src="/images/asset-avatar/Main.png" alt="CekUangku Avatar">
                CekUangku
            </a>

            <div class="visual-card">
                <h1>Kelola finansial harian dengan lebih rapi.</h1>
                <p>Catat pemasukan, pantau pengeluaran, dan lihat progres budget Anda dalam satu dashboard yang jelas.</p>
                <div class="visual-footer">
                    <div class="pill">Real-time insight</div>
                    <div class="pill">Budget per kategori</div>
                    <div class="pill">Laporan bulanan</div>
                </div>
            </div>

            <div class="visual-hero" aria-hidden="true">
                <img src="/images/asset-avatar/Happy.png" alt="">
            </div>
        </section>

        <section class="form-area">
            <div class="form-card">
                <div class="form-header">
                    <div class="form-title">
                        <h2>Masuk ke akun Anda</h2>
                        <p>Selamat datang kembali, lanjutkan pengelolaan keuangan.</p>
                    </div>
                </div>

                <% if (message) { %>
                    <div class="alert-box">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <div><%= message %></div>
                    </div>
                <% } %>

                <form action="/auth/login" method="POST" autocomplete="on">
                    <div class="form-group">
                        <label for="email">Email</label>
                        <div class="input-wrap">
                            <span class="input-icon">✉</span>
                            <input id="email" type="email" name="email" class="form-control" placeholder="name@gmail.com" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-wrap">
                            <span class="input-icon">🔒</span>
                            <input id="password" type="password" name="password" class="form-control" placeholder="Masukkan password" required>
                            <button type="button" class="toggle-visibility" aria-label="Tampilkan password" data-target="password">👁</button>
                        </div>
                    </div>

                    <div class="row">
                        <span>Gunakan email terdaftar</span>
                        <a href="/auth/register" data-transition="true">Buat akun</a>
                    </div>

                    <button type="submit" class="btn-primary">Login</button>
                </form>

                <button type="button" data-href="/auth/register" class="btn-secondary">
                    Belum punya akun? Daftar sekarang
                </button>

                <div class="helper">
                    Lupa password? Hubungi admin atau buat ulang akun.
                </div>
            </div>
        </section>
    </div>

    <div class="loading-modal" id="loadingModal" aria-hidden="true">
        <div class="loading-card" role="status" aria-live="polite">
            <video class="loading-video" src="/images/asset-avatar/loadingAnimations.mp4" autoplay muted loop playsinline></video>
            <div class="loading-title">Memproses login...</div>
            <div class="progress-track">
                <div class="progress-bar"></div>
            </div>
        </div>
    </div>

    <script>
        (function() {
            const toggle = document.querySelector('.toggle-visibility');
            if (!toggle) return;
            const input = document.getElementById(toggle.dataset.target);
            if (!input) return;

            function scrambleReveal(el, durationMs) {
                const original = el.value;
                if (!original) return;

                const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@#$%^&*';
                const start = performance.now();
                el.readOnly = true;

                function tick(now) {
                    const t = Math.min((now - start) / durationMs, 1);
                    const revealCount = Math.floor(t * original.length);
                    let out = '';

                    for (let i = 0; i < original.length; i++) {
                        if (i < revealCount) {
                            out += original[i];
                        } else {
                            out += chars[Math.floor(Math.random() * chars.length)];
                        }
                    }

                    el.value = out;

                    if (t < 1) {
                        requestAnimationFrame(tick);
                    } else {
                        el.value = original;
                        el.readOnly = false;
                    }
                }

                requestAnimationFrame(tick);
            }

            toggle.addEventListener('click', function() {
                const isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                toggle.textContent = isHidden ? '🙈' : '👁';
                toggle.setAttribute('aria-label', isHidden ? 'Sembunyikan password' : 'Tampilkan password');
                toggle.classList.remove('animate');
                void toggle.offsetWidth;
                toggle.classList.add('animate');

                if (isHidden) {
                    scrambleReveal(input, 380);
                }
            });
        })();
    </script>

    <script>
        (function() {
            document.body.classList.add('is-entering');
            window.setTimeout(function() {
                document.body.classList.remove('is-entering');
            }, 980);

            function leaveTo(url) {
                document.body.classList.add('is-leaving');
                setTimeout(function() {
                    window.location.href = url;
                }, 420);
            }

            document.querySelectorAll('a[data-transition]').forEach(function(link) {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    leaveTo(link.getAttribute('href'));
                });
            });

            document.querySelectorAll('button[data-href]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    leaveTo(btn.getAttribute('data-href'));
                });
            });
        })();
    </script>

    <script>
        (function() {
            const form = document.querySelector('form[action="/auth/login"]');
            const modal = document.getElementById('loadingModal');
            if (!form || !modal) return;

            let locked = false;
            form.addEventListener('submit', function(e) {
                if (locked) return;
                e.preventDefault();
                locked = true;
                modal.classList.add('show');
                setTimeout(function() {
                    form.submit();
                }, 3000);
            });
        })();
    </script>

    <script>
        (function() {
            const themeToggle = document.getElementById('themeToggle');
            const icon = themeToggle.querySelector('i');
            if(!themeToggle || !icon) return;
            
            const storedTheme = localStorage.getItem('theme');
            if (storedTheme === 'dark') {
                document.body.classList.add('dark-mode');
                icon.classList.replace('fa-moon', 'fa-sun');
            }
            
            themeToggle.addEventListener('click', () => {
                themeToggle.classList.add('rotated');
                setTimeout(() => { themeToggle.classList.remove('rotated'); }, 300);

                document.body.classList.toggle('dark-mode');
                if (document.body.classList.contains('dark-mode')) {
                    icon.classList.replace('fa-moon', 'fa-sun');
                    localStorage.setItem('theme', 'dark');
                } else {
                    icon.classList.replace('fa-sun', 'fa-moon');
                    localStorage.setItem('theme', 'light');
                }
            });
        })();
    </script>
</body>
</html>
