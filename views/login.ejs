<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - CekUangku</title>
    <!-- Link ke CSS yang kita buat -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Awesome untuk Icon Sosial -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>

<div class="split-screen">
    <!-- Panel Kiri: Ilustrasi -->
    <div class="left-pane">
        <div class="circle-bg c1"></div>
        <div class="circle-bg c2"></div>
        <!-- Gambar Ilustrasi Placeholder (mirip dompet/koin) -->
        <img src="https://cdni.iconscout.com/illustration/premium/thumb/login-3305943-2757111.png" alt="Finance Illustration">
        <h2>CekUangku</h2>
        <p>Kelola keuangan Anda dengan mudah, aman, dan cepat bersama kami.</p>
    </div>

    <!-- Panel Kanan: Form Login -->
    <div class="right-pane">
        <div class="form-container">
            <div class="welcome-text">
                <h2>Welcome Back : )</h2>
                <p>Silakan masuk ke akun Anda</p>
            </div>

            <!-- Pesan Error (jika ada dari backend) -->
            <% if (typeof message != 'undefined' && message.length > 0) { %>
                <div style="background: #f8d7da; color: #721c24; padding: 10px; border-radius: 5px; margin-bottom: 15px; font-size: 0.9rem;">
                    <%= message %>
                </div>
            <% } %>

            <form action="/auth/login" method="POST">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="name@company.com" required>
                </div>
                
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>

                <button type="submit" class="btn btn-primary">Login</button>
            </form>

            <div class="social-login">
                <div class="divider"><span>Or login with</span></div>
                <div class="social-icons">
                    <a href="#"><i class="fab fa-google"></i></a>
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>
            </div>

            <a href="/auth/register" class="btn-link">Belum punya akun? Join Now</a>
            
            <div style="text-align: center; margin-top: 20px; font-size: 0.8rem; color: #999;">
                &copy; 2023 CekUangku Inc.
            </div>
        </div>
    </div>
</div>

</body>
</html>